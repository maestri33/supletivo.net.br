---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';

const title = 'Página não encontrada (404) | Supletivo Brasil';
const description = 'A página que você procura não foi encontrada ou foi movida. Volte para a página inicial do Supletivo Brasil.';
---

<Base {title} {description} noindex={true}>
  <div class="error-page">
    <header class="error-header">
      <div class="container">
        <Logo variant="dark" />
      </div>
    </header>

    <main id="conteudo" class="error-main">
      <div class="container narrow error-content">
        <span class="error-code">404</span>
        <h1>Página não encontrada</h1>
        <p>
          O endereço que você tentou acessar não existe, foi alterado ou está temporariamente indisponível.
        </p>
        <a href="/" class="btn btn-primary">Voltar para o início</a>
      </div>
    </main>
  </div>
</Base>

<style>
  .error-page {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    background: var(--paper-soft);
  }

  .error-header {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line-light);
  }

  .error-main {
    flex: 1;
    display: grid;
    place-items: center;
    padding-block: 4rem;
    text-align: center;
  }

  .error-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
  }

  .error-code {
    font-family: var(--font-display);
    font-size: clamp(4rem, 10vw, 7rem);
    line-height: 1;
    color: var(--blue);
    opacity: 0.85;
  }

  h1 {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    color: var(--ink);
  }

  p {
    max-width: 32rem;
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: 0.8rem;
  }

  .btn-primary {
    background: var(--blue);
    color: #ffffff;
    padding: 0.9rem 2rem;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px -8px rgba(0, 39, 118, 0.4);
  }
</style>
