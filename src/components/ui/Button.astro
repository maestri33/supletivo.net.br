---
import { twMerge } from 'tailwind-merge';
import type { CallToAction as Props } from '~/types';

const {
  variant = 'primary',
  target,
  text = await Astro.slots.render('default'),
  class: className = '',
  type,
  href,
  ...rest
} = Astro.props as Props;

const variants: Record<string, string> = {
  primary:
    'bg-[var(--yellow)] text-[var(--ink)] font-bold rounded-full min-h-[48px] px-6 md:px-8 py-3.5 inline-flex items-center justify-center text-center transition-all duration-200 hover:scale-[1.02] active:scale-[0.98] shadow-sm hover:shadow-md cursor-pointer whitespace-nowrap focus-visible:outline-2 focus-visible:outline-[var(--yellow)] focus-visible:outline-offset-2',
  secondary:
    'bg-transparent border border-[var(--line-light)] text-[var(--ink)] dark:text-[var(--paper)] font-semibold rounded-full min-h-[48px] px-6 py-3.5 inline-flex items-center justify-center text-center transition-colors hover:bg-[var(--paper-soft)] dark:hover:bg-[var(--ink-soft)] cursor-pointer whitespace-nowrap focus-visible:outline-2 focus-visible:outline-[var(--blue)] focus-visible:outline-offset-2',
  tertiary:
    'bg-transparent text-[var(--muted-on-light)] hover:text-[var(--ink)] dark:text-[var(--muted-on-dark)] dark:hover:text-[var(--paper)] font-semibold inline-flex items-center justify-center min-h-[48px] px-4 py-2 cursor-pointer whitespace-nowrap transition-colors',
  link:
    'text-[var(--blue)] hover:underline inline-flex items-center cursor-pointer font-medium p-0',
};

const resolvedClass = twMerge(variants[variant] || variants.primary, className);
---

{
  type === 'button' || type === 'submit' || type === 'reset' ? (
    <button type={type} class={resolvedClass} {...rest}>
      <Fragment set:html={text} />
      <slot />
    </button>
  ) : (
    <a
      href={href}
      class={resolvedClass}
      {...(target ? { target, rel: 'noopener noreferrer' } : {})}
      {...rest}
    >
      <Fragment set:html={text} />
      <slot />
    </a>
  )
}
