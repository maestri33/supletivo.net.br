---
/**
 * Barra de progresso de leitura hardware-accelerated com assinatura visual Supletivo Brasil.
 * Renderiza o gradiente verde-amarelo e o bead luminoso viajando em sincronia com o scroll.
 * Suporta CSS Scroll-Driven Animations nativo com fallback em scripts/main.ts.
 */
---

<div class="reading-track" aria-hidden="true" role="presentation">
  <div class="reading-bar"></div>
  <div class="reading-bead"></div>
</div>

<style>
  .reading-track {
    position: fixed;
    inset-inline: 0;
    top: 0;
    height: 4px;
    z-index: 60;
    background-color: color-mix(in srgb, var(--ink) 10%, rgba(255, 255, 255, 0.08));
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    pointer-events: none;
    container-type: inline-size;
    padding-inline: env(safe-area-inset-left, 0) env(safe-area-inset-right, 0);
    overflow: visible;
  }

  .reading-bar {
    height: 100%;
    width: 100%;
    background-image: linear-gradient(90deg, var(--green) 0%, var(--green-deep) 28%, var(--yellow) 60%, var(--yellow-soft) 78%, var(--blue) 100%);
    transform-origin: 0% 50%;
    will-change: transform;
    transform: scaleX(var(--progress-scale, 0));
  }

  .reading-bead {
    position: absolute;
    top: 50%;
    left: 0;
    width: 8px;
    height: 8px;
    margin-top: -4px;
    margin-left: -4px;
    border-radius: 50%;
    background-color: #ffffff;
    box-shadow: 0 0 10px 2px color-mix(in srgb, var(--yellow-soft) 75%, transparent), 0 0 4px color-mix(in srgb, var(--blue) 40%, transparent);
    will-change: transform;
    transform: translate3d(calc(var(--progress-scale, 0) * (100cqw - 8px)), 0, 0);
  }

  /* CSS Scroll-Driven Animation (Compositor Level) */
  @supports (animation-timeline: scroll()) {
    .reading-bar {
      animation: progress-scale linear both;
      animation-timeline: scroll(root);
      animation-range: 0% 100%;
    }

    .reading-bead {
      animation: bead-travel linear both;
      animation-timeline: scroll(root);
      animation-range: 0% 100%;
    }
  }

  @keyframes progress-scale {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  @keyframes bead-travel {
    0% {
      transform: translate3d(0, 0, 0);
      opacity: 0;
    }
    2% {
      opacity: 1;
    }
    100% {
      transform: translate3d(calc(100cqw - 8px), 0, 0);
      opacity: 1;
    }
  }

  /* Exibição exclusiva em viewports mobile (< 768px) */
  @media (min-width: 768px) {
    .reading-track {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-track {
      display: none !important;
    }
  }

  :global(html:not(.js)) .reading-track {
    display: none;
  }
</style>
