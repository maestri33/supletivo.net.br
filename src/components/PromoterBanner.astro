---
/**
 * Banner de consultor / indicação com desconto especial.
 * Inicialmente oculto no HTML estático; ativado via client-side
 * quando o visitante possui um parâmetro `?ref=` válido.
 */
---

<div
  id="promoter-banner"
  class="promoter-banner hidden"
  data-promoter-banner
  aria-live="polite"
>
</div>

<style is:global>
  .promoter-banner {
    position: absolute;
    top: 72px;
    left: 0;
    right: 0;
    width: 100%;
    background: linear-gradient(90deg, var(--ink) 0%, var(--blue-deep) 50%, var(--ink-soft) 100%);
    border-bottom: 1px solid color-mix(in srgb, var(--yellow) 30%, transparent);
    color: var(--yellow-soft);
    padding-block: 0.65rem;
    font-size: 0.88rem;
    z-index: 40;
    box-sizing: border-box;
    transition: opacity 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  }

  .promoter-banner.hidden {
    display: none;
  }

  .promoter-banner.is-visible {
    display: block;
    animation: bannerFadeIn 0.3s var(--ease-out) forwards;
  }

  .promoter-banner-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    text-align: center;
  }

  .promoter-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: color-mix(in srgb, var(--yellow) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--yellow) 40%, transparent);
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
  }

  .promoter-icon {
    width: 14px;
    height: 14px;
    color: var(--yellow);
  }

  .promoter-pill {
    font-size: 0.84rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--yellow-soft);
  }

  .promoter-text {
    margin: 0;
    color: var(--paper);
  }

  .promoter-text strong {
    color: var(--yellow-soft);
    font-weight: 700;
  }

  @keyframes bannerFadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (max-width: 640px) {
    .promoter-banner {
      top: 61px;
      font-size: 0.8rem;
      padding-block: 0.5rem;
    }
  }
</style>
