---
/**
 * Faixa de texto em loop infinito (assinatura visual da página).
 * Decorativa: aria-hidden no track, conteúdo real em .sr-only.
 * prefers-reduced-motion: vira faixa estática.
 */
interface Props {
  items: string[];
  variant?: 'yellow' | 'green' | 'ink';
  /** segundos por loop */
  speed?: number;
  /** graus de rotação da faixa */
  tilt?: number;
  priceIndex?: number;
}
const { items, variant = 'yellow', speed = 28, tilt = 0, priceIndex } = Astro.props;
// loop seamless: 2 <ul> idênticas + translateX(-50%). Cada <ul> precisa
// ser mais larga que a viewport. Duplicatas visuais recebem aria-hidden="true"
// para manter exatamente 1 cópia semântica indexável por buscadores e leitores.
const halfItems = [...items, ...items];
---

<div
  class={`marquee marquee--${variant}`}
  style={`--speed: ${speed}s; --tilt: ${tilt}deg`}
>
  <div class="marquee-track">
    <ul>
      {halfItems.map((item, i) => (
        <li
          aria-hidden={i >= items.length ? 'true' : undefined}
          data-price-card-line={i % items.length === priceIndex ? true : undefined}
        >
          {item}
        </li>
      ))}
    </ul>
    <ul aria-hidden="true">
      {halfItems.map((item, i) => (
        <li data-price-card-line={i % items.length === priceIndex ? true : undefined}>
          {item}
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .marquee {
    overflow: clip;
    transform: rotate(var(--tilt));
    padding-block: 0.72rem;
    user-select: none;
  }

  .marquee--yellow {
    background: var(--yellow);
    color: var(--ink);
  }

  .marquee--green {
    background: var(--green-deep);
    color: var(--paper);
  }

  .marquee--ink {
    background: var(--ink);
    color: var(--paper);
    border-block: none;
  }

  .marquee-track {
    display: flex;
    width: max-content;
  }

  .marquee-track ul {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    flex: none;
  }

  .marquee-track li {
    display: flex;
    align-items: center;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: 0.92rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* losango separador (motivo da marca) */
  .marquee-track li::after {
    content: '';
    width: 0.45em;
    height: 0.45em;
    margin-inline: 1.4rem;
    background: currentColor;
    opacity: 0.55;
    transform: rotate(45deg);
    border-radius: 1.5px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .marquee-track {
      animation: marquee-x var(--speed) linear infinite;
    }
  }

  @keyframes marquee-x {
    to {
      transform: translateX(-50%);
    }
  }
</style>
