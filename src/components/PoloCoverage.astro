---
/**
 * PoloCoverage.astro — Consulta de Polos Presenciais Credenciados.
 * Elimina a principal objeção de conversão antes do pagamento:
 * "Onde eu faço a prova final? Tem polo perto de mim?".
 * Design System: Pátria Amada Refinada + Glassmorphism Antigravity (DESIGN.md).
 */
import { BRAZIL_STATES_POLOS } from '../data/polos';

const defaultState = BRAZIL_STATES_POLOS[0]; // SP por padrão
const topStates = ['SP', 'RJ', 'MG', 'PR', 'BA', 'DF', 'RS', 'PE', 'GO', 'SC'];
---

<section id="polos" class="polo-coverage section on-dark grain" aria-labelledby="polos-title" data-section="polos">
  <div class="container">
    <div class="polo-header" data-reveal>
      <p class="kicker">Cobertura Nacional · 26 Estados + DF</p>
      <h2 id="polos-title">Onde você faz a prova final presencial?</h2>
      <p class="polo-lead">
        A prova presencial é a garantia legal que dá fé pública ao seu diploma pela LDB.
        Temos escolas parceiras e polos credenciados em todo o Brasil para você concluir
        perto de casa, com agendamento flexível pelo aplicativo.
      </p>
    </div>

    <div class="polo-box glass-panel spatial-card-3d" data-reveal style="--d: 1">
      <div class="polo-selector-bar">
        <label for="polo-uf-select" class="polo-label">
          <svg class="pin-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            <circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2"></circle>
          </svg>
          Selecione seu Estado:
        </label>
        <div class="select-wrapper">
          <select id="polo-uf-select" class="polo-select" aria-label="Selecione seu estado para ver os polos parceiros">
            {BRAZIL_STATES_POLOS.map((st) => (
              <option value={st.uf} selected={st.uf === defaultState.uf}>
                {st.name} ({st.uf}) — Região {st.region}
              </option>
            ))}
          </select>
          <svg class="select-arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </div>
      </div>

      <div class="quick-chips" aria-label="Estados mais buscados">
        <span class="quick-label">Mais buscados:</span>
        <div class="chips-list">
          {topStates.map((uf) => {
            const st = BRAZIL_STATES_POLOS.find((s) => s.uf === uf);
            return (
              <button
                type="button"
                class:list={['polo-chip', { 'is-active': uf === defaultState.uf }]}
                data-uf={uf}
                aria-label={`Ver polos no estado de ${st?.name}`}
              >
                {uf}
              </button>
            );
          })}
        </div>
      </div>

      <div id="polo-result" class="polo-result-card" data-current-uf={defaultState.uf}>
        <div class="result-header">
          <div class="result-state-info">
            <span class="status-indicator">
              <span class="pulse-dot"></span>
              <span class="status-text">Polos Ativos com Vagas Abertas</span>
            </span>
            <h3 id="polo-state-title" class="result-title">{defaultState.name} ({defaultState.uf})</h3>
            <p id="polo-region-subtitle" class="result-subtitle">Região {defaultState.region} · Atendimento Presencial Homologado</p>
          </div>
          <div class="result-badge">
            <span class="badge-num" id="polo-count">{defaultState.hubs.length}+</span>
            <span class="badge-label">Cidades / Regiões com Polo</span>
          </div>
        </div>

        <div class="hubs-container">
          <p class="hubs-intro">Principais cidades e centros de prova parceiros no estado:</p>
          <ul id="polo-hubs-list" class="hubs-grid">
            {defaultState.hubs.map((hub) => (
              <li class="hub-item">
                <svg class="hub-check" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <circle cx="10" cy="10" r="9" fill="color-mix(in srgb, var(--green) 20%, transparent)" stroke="var(--green)" stroke-width="1.5"></circle>
                  <path d="M6 10.2l2.6 2.6 5.4-5.6" stroke="var(--green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                <span>{hub}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="result-footer">
          <div class="footer-check-item">
            <svg class="check-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span><strong>Data à sua escolha:</strong> Agendamento flexível de segunda a sábado diretamente no app</span>
          </div>
          <div class="footer-check-item">
            <svg class="check-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span><strong>Sem taxas extras no polo:</strong> Toda a aplicação e emissão da documentação inclusas na sua matrícula</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .polo-coverage {
    background: var(--ink);
    color: var(--paper);
    padding-block: clamp(4rem, 8vw, 6.5rem);
    position: relative;
    border-top: 1px solid var(--glass-border-dark);
  }

  .polo-header {
    max-width: 48rem;
    margin-bottom: 2.5rem;
  }

  .polo-header .kicker {
    color: var(--yellow);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }

  #polos-title {
    font-size: clamp(1.85rem, 1.3rem + 2.4vw, 3.2rem);
    line-height: 1.12;
    margin-bottom: 1rem;
  }

  .polo-lead {
    color: var(--muted-on-dark);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.15rem);
    line-height: 1.55;
  }

  .polo-box {
    background: linear-gradient(180deg, var(--ink-soft) 0%, color-mix(in srgb, var(--ink) 85%, #000) 100%);
    border: 1px solid var(--glass-border-dark);
    border-radius: var(--radius-lg, 24px);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    box-shadow: var(--shadow-zero-g);
  }

  .polo-selector-bar {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  @media (min-width: 640px) {
    .polo-selector-bar {
      flex-direction: row;
      align-items: center;
      gap: 1.25rem;
    }
  }

  .polo-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1.02rem;
    color: var(--paper-soft);
    white-space: nowrap;
  }

  .pin-icon {
    width: 22px;
    height: 22px;
    color: var(--yellow);
  }

  .select-wrapper {
    position: relative;
    flex: 1;
    max-width: 30rem;
  }

  .polo-select {
    width: 100%;
    min-height: var(--input-height, 48px);
    background: var(--ink);
    border: 1.5px solid var(--glass-border-dark);
    border-radius: var(--input-radius, 10px);
    padding: 0.65rem 2.8rem 0.65rem 1rem;
    color: var(--paper);
    font-family: var(--font-body);
    font-size: 0.98rem;
    font-weight: 600;
    cursor: pointer;
    appearance: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .polo-select:focus-visible {
    outline: none;
    border-color: var(--yellow);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--yellow) 30%, transparent);
  }

  .select-arrow {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    width: 20px;
    height: 20px;
    color: var(--muted-on-dark);
    pointer-events: none;
  }

  .quick-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .quick-label {
    font-size: 0.84rem;
    color: var(--muted-on-dark);
    margin-right: 0.25rem;
  }

  .chips-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .polo-chip {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--muted-on-dark);
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 700;
    min-height: 44px;
    min-width: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .polo-chip:hover {
    background: rgba(255, 255, 255, 0.12);
    color: var(--paper);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .polo-chip.is-active {
    background: var(--yellow);
    color: var(--ink);
    border-color: var(--yellow);
    font-weight: 800;
    box-shadow: 0 2px 10px color-mix(in srgb, var(--yellow) 40%, transparent);
  }

  .polo-result-card {
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius, 16px);
    padding: clamp(1.25rem, 3vw, 1.85rem);
  }

  .result-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: space-between;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  @media (min-width: 640px) {
    .result-header {
      flex-direction: row;
      align-items: flex-start;
    }
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: color-mix(in srgb, var(--green) 18%, transparent);
    border: 1px solid color-mix(in srgb, var(--green) 45%, transparent);
    color: #4ade80;
    padding: 0.22rem 0.7rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 0.65rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 8px #4ade80;
    animation: pulse-ring 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes pulse-ring {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.2); }
  }

  .result-title {
    font-size: 1.45rem;
    font-family: var(--font-display);
    color: var(--paper);
    margin-bottom: 0.25rem;
  }

  .result-subtitle {
    color: var(--muted-on-dark);
    font-size: 0.88rem;
    margin: 0;
  }

  .result-badge {
    background: color-mix(in srgb, var(--yellow) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--yellow) 30%, transparent);
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius, 12px);
    text-align: center;
    align-self: flex-start;
  }

  .badge-num {
    display: block;
    font-family: var(--font-display);
    font-size: 1.55rem;
    color: var(--yellow);
    line-height: 1;
  }

  .badge-label {
    display: block;
    font-size: 0.75rem;
    color: var(--muted-on-dark);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.35rem;
  }

  .hubs-container {
    padding-block: 1.25rem;
  }

  .hubs-intro {
    font-size: 0.92rem;
    color: var(--paper-soft);
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .hubs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .hub-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.65rem 0.9rem;
    border-radius: 8px;
    font-size: 0.88rem;
    color: var(--paper-soft);
    font-weight: 500;
  }

  .hub-check {
    width: 18px;
    height: 18px;
    flex: none;
  }

  .result-footer {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  @media (min-width: 640px) {
    .result-footer {
      grid-template-columns: 1fr 1fr;
    }
  }

  .footer-check-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.84rem;
    color: var(--muted-on-dark);
    line-height: 1.45;
  }

  .check-icon {
    width: 18px;
    height: 18px;
    color: var(--green);
    flex: none;
    margin-top: 0.15rem;
  }

  .footer-check-item strong {
    color: var(--paper);
  }
</style>

<script>
  import { BRAZIL_STATES_POLOS } from '../data/polos';

  const select = document.querySelector<HTMLSelectElement>('#polo-uf-select');
  const chips = document.querySelectorAll<HTMLButtonElement>('.polo-chip');
  const title = document.querySelector<HTMLElement>('#polo-state-title');
  const subtitle = document.querySelector<HTMLElement>('#polo-region-subtitle');
  const count = document.querySelector<HTMLElement>('#polo-count');
  const hubsList = document.querySelector<HTMLElement>('#polo-hubs-list');
  const resultCard = document.querySelector<HTMLElement>('#polo-result');

  function updatePoloView(uf: string): void {
    const data = BRAZIL_STATES_POLOS.find((s) => s.uf === uf);
    if (!data) return;

    if (title) title.textContent = `${data.name} (${data.uf})`;
    if (subtitle) subtitle.textContent = `Região ${data.region} · Atendimento Presencial Homologado`;
    if (count) count.textContent = `${data.hubs.length}+`;
    if (resultCard) resultCard.dataset.currentUf = uf;

    if (hubsList) {
      hubsList.innerHTML = data.hubs
        .map(
          (hub) => `
        <li class="hub-item">
          <svg class="hub-check" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="10" cy="10" r="9" fill="rgba(0, 115, 77, 0.2)" stroke="#00734d" stroke-width="1.5"></circle>
            <path d="M6 10.2l2.6 2.6 5.4-5.6" stroke="#00734d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <span>${hub}</span>
        </li>`
        )
        .join('');
    }

    if (select && select.value !== uf) {
      select.value = uf;
    }

    chips.forEach((c) => {
      c.classList.toggle('is-active', c.dataset.uf === uf);
    });
  }

  select?.addEventListener('change', (e) => {
    updatePoloView((e.target as HTMLSelectElement).value);
  });

  chips.forEach((c) => {
    c.addEventListener('click', () => {
      const uf = c.dataset.uf;
      if (uf) updatePoloView(uf);
    });
  });
</script>
