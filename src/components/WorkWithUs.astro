---
/**
 * Seção Destaque — Trabalhe Conosco / Seja um Promotor ou Polo Parceiro.
 * Apresenta o programa oficial de remuneração por indicação e expansão de polos,
 * conectando o visitante à oportunidade de renda extra com propósito educacional.
 */
import { CAREERS_URL, BRAND } from '../config';
---

<section
  id="trabalhe-conosco"
  class="work-with-us section on-dark grain"
  aria-labelledby="work-title"
  data-section="trabalhe-conosco"
>
  <span class="sec-num" aria-hidden="true" data-n="07"></span>

  <!-- Luzes de fundo espaciais sutis -->
  <div class="ambient-glow glow-green" aria-hidden="true"></div>
  <div class="ambient-glow glow-gold" aria-hidden="true"></div>

  <div class="container work-container spatial-stage">
    <!-- Header da Seção -->
    <div class="work-header" data-reveal>
      <div class="work-kicker-wrap">
        <span class="work-badge">
          <span class="badge-pulse-beacon" aria-hidden="true">
            <span class="beacon-pulse"></span>
            <span class="beacon-dot"></span>
          </span>
          Vagas Abertas em Todo o Brasil
        </span>
        <p class="kicker work-kicker">Trabalhe Conosco · Programa de Parceiros</p>
      </div>

      <h2 id="work-title" class="work-title">
        Ajude pessoas a conquistar o diploma e ganhe no Pix toda semana
      </h2>

      <p class="work-lead" style="--d: 1">
        Você conhece amigos, parentes ou colegas de trabalho que não terminaram o Ensino Fundamental ou Médio?
        Torne-se um <strong>Promotor Parceiro {BRAND}</strong>: indique o supletivo 100% online pelo celular,
        ajude a transformar futuros e receba comissão direta na sua conta por cada matrícula confirmada.
      </p>
    </div>

    <!-- Card Principal Spatial 3D -->
    <div
      class="work-spatial-card spatial-card-3d glass-panel"
      data-tilt-3d
      data-tilt-max="4"
      data-reveal
      style="--d: 2"
    >
      <!-- Grid Bento com os 3 Pilares -->
      <div class="bento-grid">
        <!-- Pilar 1: Comissão no Pix -->
        <div class="bento-card bento-card-highlight">
          <div class="bento-card-top">
            <div class="bento-icon-wrap icon-green">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="5" width="20" height="14" rx="2" />
                <line x1="2" y1="10" x2="22" y2="10" />
                <circle cx="12" cy="15" r="2" />
              </svg>
            </div>
            <span class="bento-tag">Pix Semanal</span>
          </div>
          <div class="bento-value">R$ 100<span class="bento-cents">,00</span></div>
          <h3 class="bento-title">Por matrícula confirmada</h3>
          <p class="bento-desc">
            Pagamento semanal direto no seu Pix, sem pegadinhas nem carência. A cada pessoa matriculada que você ajudou a orientar, sua recompensa cai na conta.
          </p>
        </div>

        <!-- Pilar 2: 100% Celular / Zero Custo -->
        <div class="bento-card">
          <div class="bento-card-top">
            <div class="bento-icon-wrap icon-yellow">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="5" y="2" width="14" height="20" rx="3" />
                <line x1="12" y1="18" x2="12.01" y2="18" stroke-width="2.5" />
              </svg>
            </div>
            <span class="bento-tag">Zero Investimento</span>
          </div>
          <div class="bento-feature-title">100% Remoto pelo Celular</div>
          <h3 class="bento-title">Sem taxas e sem estoque</h3>
          <p class="bento-desc">
            Cadastro 100% gratuito. Você recebe link exclusivo de consultor e materiais oficiais de alta conversão para WhatsApp, Instagram e no boca a boca do dia a dia.
          </p>
        </div>

        <!-- Pilar 3: Portal do Promotor -->
        <div class="bento-card">
          <div class="bento-card-top">
            <div class="bento-icon-wrap icon-blue">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 3v18h18" />
                <path d="m19 9-5 5-4-4-3 3" />
              </svg>
            </div>
            <span class="bento-tag">Tecnologia Própria</span>
          </div>
          <div class="bento-feature-title">Painel em Tempo Real</div>
          <h3 class="bento-title">Transparência absoluta</h3>
          <p class="bento-desc">
            Acompanhe cada indicado, status de envio de documentos, pagamentos confirmados e histórico de comissões com login próprio no portal do promotor.
          </p>
        </div>
      </div>

      <!-- Faixa de Expansão: Polos e Escolas Parceiras -->
      <div class="hub-callout" data-reveal style="--d: 3">
        <div class="hub-callout-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 21h18M3 10h18M5 10v11M9 10v11M15 10v11M19 10v11M12 3l9 7H3z" />
          </svg>
        </div>
        <div class="hub-callout-content">
          <h4 class="hub-callout-title">Tem escola, polo EAD, centro de formação ou espaço físico?</h4>
          <p class="hub-callout-text">
            Torne-se um <strong>Polo Parceiro Autorizado {BRAND}</strong> na sua cidade. Ofereça o supletivo na sua região com suporte institucional, material e modelo de remuneração diferenciado para instituições.
          </p>
        </div>
        <a
          href={`${CAREERS_URL}#requisitos`}
          target="_blank"
          rel="noopener noreferrer"
          class="hub-callout-link"
        >
          <span>Credenciar Polo</span>
          <span class="hub-arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Ação Principal e Fechamento -->
      <div class="work-action-wrap" data-reveal style="--d: 4">
        <div class="work-action-buttons">
          <a
            href={CAREERS_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-careers-primary"
            data-cta="work_with_us"
          >
            <span>Cadastrar-se como Promotor Grátis</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>

          <a
            href={CAREERS_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="work-secondary-link"
          >
            Ver detalhes do programa e depoimentos de consultores
            <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="work-trust-items" aria-label="Garantias da parceria">
          <span class="trust-item">
            <svg viewBox="0 0 20 20" fill="currentColor" class="check-icon" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            Cadastro 100% gratuito em 2 minutos
          </span>
          <span class="trust-item">
            <svg viewBox="0 0 20 20" fill="currentColor" class="check-icon" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            Treinamento e materiais prontos inclusos
          </span>
          <span class="trust-item">
            <svg viewBox="0 0 20 20" fill="currentColor" class="check-icon" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            Comissão semanal depositada no Pix
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .work-with-us {
    position: relative;
    background-color: var(--ink);
    color: var(--paper);
    padding-block: clamp(4.5rem, 6vw, 7.5rem);
    overflow: clip;
  }

  /* Luzes ambientais antigravidade */
  .ambient-glow {
    position: absolute;
    border-radius: 9999px;
    filter: blur(90px);
    pointer-events: none;
    opacity: 0.45;
  }

  .glow-green {
    top: 15%;
    right: 5%;
    width: clamp(260px, 35vw, 500px);
    height: clamp(260px, 35vw, 500px);
    background: radial-gradient(circle, rgba(0, 115, 77, 0.45) 0%, transparent 70%);
  }

  .glow-gold {
    bottom: 10%;
    left: 5%;
    width: clamp(240px, 30vw, 420px);
    height: clamp(240px, 30vw, 420px);
    background: radial-gradient(circle, rgba(255, 196, 0, 0.22) 0%, transparent 70%);
  }

  .work-container {
    position: relative;
    z-index: 2;
  }

  /* Header da seção */
  .work-header {
    max-width: 52rem;
    margin-inline: auto;
    text-align: center;
    margin-bottom: clamp(2.5rem, 4vw, 3.8rem);
  }

  .work-kicker-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .work-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.95rem;
    border-radius: 999px;
    background: rgba(0, 115, 77, 0.25);
    border: 1px solid rgba(0, 230, 153, 0.4);
    color: var(--yellow-soft);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Beacon pulsante */
  .badge-pulse-beacon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 10px;
    height: 10px;
  }

  .badge-pulse-beacon .beacon-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background-color: #00e699;
    box-shadow: 0 0 6px #00e699;
  }

  .badge-pulse-beacon .beacon-pulse {
    position: absolute;
    inset: -3px;
    border-radius: 999px;
    background-color: rgba(0, 230, 153, 0.5);
    animation: beaconPulse 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes beaconPulse {
    0% { transform: scale(0.8); opacity: 0.9; }
    70%, 100% { transform: scale(2.2); opacity: 0; }
  }

  .work-kicker {
    color: var(--yellow);
    font-weight: 800;
    margin: 0;
  }

  .work-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 2.8vw, 3.4rem);
    line-height: 1.1;
    color: var(--paper);
    margin-bottom: 1.25rem;
  }

  .work-lead {
    font-size: clamp(1.05rem, 0.95rem + 0.45vw, 1.25rem);
    line-height: 1.65;
    color: var(--muted-on-dark);
    margin: 0;
  }

  .work-lead strong {
    color: var(--yellow-soft);
  }

  /* Card Spatial 3D Principal */
  .work-spatial-card {
    position: relative;
    background: rgba(18, 29, 51, 0.72);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-lg);
    box-shadow: 0 24px 60px -15px rgba(0, 0, 0, 0.55), 0 0 1px 1px rgba(255, 255, 255, 0.08);
    padding: clamp(1.75rem, 4vw, 3.25rem);
    overflow: hidden;
  }

  /* Grid Bento com 3 colunas */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .bento-card {
    display: flex;
    flex-direction: column;
    padding: 1.65rem 1.4rem;
    border-radius: var(--radius);
    background: rgba(11, 18, 32, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: transform 0.25s var(--ease-out), border-color 0.25s ease, background-color 0.25s ease;
  }

  .bento-card:hover {
    transform: translateY(-3px);
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(11, 18, 32, 0.85);
  }

  .bento-card-highlight {
    background: linear-gradient(145deg, rgba(0, 115, 77, 0.28) 0%, rgba(11, 18, 32, 0.75) 100%);
    border-color: rgba(0, 230, 153, 0.35);
  }

  .bento-card-highlight:hover {
    border-color: rgba(0, 230, 153, 0.6);
  }

  .bento-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .bento-icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
  }

  .bento-icon-wrap svg {
    width: 22px;
    height: 22px;
  }

  .icon-green {
    background: rgba(0, 115, 77, 0.35);
    color: #00e699;
    border: 1px solid rgba(0, 230, 153, 0.4);
  }

  .icon-yellow {
    background: rgba(255, 196, 0, 0.2);
    color: var(--yellow);
    border: 1px solid rgba(255, 196, 0, 0.35);
  }

  .icon-blue {
    background: rgba(0, 39, 118, 0.4);
    color: #79a6fe;
    border: 1px solid rgba(121, 166, 254, 0.35);
  }

  .bento-tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--muted-on-dark);
  }

  .bento-card-highlight .bento-tag {
    background: rgba(0, 115, 77, 0.35);
    color: #00e699;
    border: 1px solid rgba(0, 230, 153, 0.3);
  }

  .bento-value {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 2rem + 1vw, 3rem);
    line-height: 1;
    color: #ffffff;
    margin-bottom: 0.35rem;
  }

  .bento-cents {
    font-size: 1.4rem;
    color: var(--yellow);
  }

  .bento-feature-title {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--yellow-soft);
    margin-bottom: 0.4rem;
  }

  .bento-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.6rem;
  }

  .bento-desc {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--muted-on-dark);
    margin: 0;
  }

  /* Faixa de Polos e Escolas */
  .hub-callout {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.35rem 1.65rem;
    border-radius: var(--radius);
    background: linear-gradient(90deg, rgba(0, 39, 118, 0.35) 0%, rgba(11, 18, 32, 0.5) 100%);
    border: 1px solid rgba(121, 166, 254, 0.25);
    margin-bottom: 2.25rem;
  }

  .hub-callout-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: rgba(0, 39, 118, 0.5);
    border: 1px solid rgba(121, 166, 254, 0.35);
    color: #79a6fe;
    flex-shrink: 0;
  }

  .hub-callout-icon svg {
    width: 24px;
    height: 24px;
  }

  .hub-callout-content {
    flex: 1;
  }

  .hub-callout-title {
    font-size: 0.98rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.2rem;
  }

  .hub-callout-text {
    font-size: 0.86rem;
    color: var(--muted-on-dark);
    margin: 0;
    line-height: 1.45;
  }

  .hub-callout-text strong {
    color: var(--yellow-soft);
  }

  .hub-callout-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.86rem;
    font-weight: 700;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 0.6rem 1.1rem;
    min-height: 44px;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.18s var(--ease-out);
  }

  .hub-callout-link:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: #ffffff;
    transform: translateX(2px);
  }

  .hub-arrow {
    transition: transform 0.18s var(--ease-out);
  }

  .hub-callout-link:hover .hub-arrow {
    transform: translateX(3px);
  }

  /* Wrap de Ação e Botão */
  .work-action-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
    padding-top: 0.5rem;
  }

  .work-action-buttons {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 100%;
  }

  /* Botão CTA Principal do Trabalhe Conosco */
  .btn-careers-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    background: var(--yellow);
    color: var(--ink);
    font-weight: 700;
    font-size: clamp(1.05rem, 0.98rem + 0.4vw, 1.25rem);
    padding: 1.15em 2.4em;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 10px 28px -8px rgba(255, 196, 0, 0.6);
    position: relative;
    overflow: hidden;
    transition: transform 0.2s var(--ease-out), box-shadow 0.25s ease;
  }

  .btn-careers-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 36px -8px rgba(255, 196, 0, 0.75);
  }

  .btn-careers-primary:active {
    transform: translateY(0) scale(0.99);
  }

  @media (prefers-reduced-motion: no-preference) {
    .btn-careers-primary::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        105deg,
        transparent 35%,
        rgba(255, 255, 255, 0.65) 50%,
        transparent 65%
      );
      transform: translateX(-140%) skewX(-10deg);
      animation: btnShine 5.2s var(--ease-out) infinite;
      pointer-events: none;
    }
  }

  @keyframes btnShine {
    0%, 75% { transform: translateX(-140%) skewX(-10deg); }
    100% { transform: translateX(140%) skewX(-10deg); }
  }

  .work-secondary-link {
    font-size: 0.92rem;
    color: var(--yellow-soft);
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: color 0.2s ease, text-decoration 0.2s ease;
  }

  .work-secondary-link:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  .work-trust-items {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    font-size: 0.88rem;
    color: var(--muted-on-dark);
  }

  .trust-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .check-icon {
    width: 17px;
    height: 17px;
    color: #00e699;
    flex-shrink: 0;
  }

  /* Responsividade */
  @media (max-width: 960px) {
    .bento-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .hub-callout {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .hub-callout-link {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 640px) {
    .work-spatial-card {
      padding: 1.35rem 1.15rem;
      border-radius: var(--radius);
    }

    .work-title {
      font-size: 1.85rem;
    }

    .btn-careers-primary {
      width: 100%;
      padding-inline: 1.25rem;
      font-size: 1rem;
      white-space: normal;
    }

    .work-trust-items {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
    }
  }
</style>
