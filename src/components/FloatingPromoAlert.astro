---
/**
 * Alerta flutuante refinado de Condição por Indicação (?ref=).
 * Alinhado estritamente ao Design System (Dark Glassmorphism, Antigravity).
 * Sem falsa escassez ou contadores artificiais.
 * Posicionado no desktop à direita (sem sobrepor o Hero CTA) e
 * com ativação inteligente que não obstrui o Hero mobile.
 * Renderizado no cliente apenas com parâmetro ?ref= ativo.
 */
---

<aside
  id="floating-promo-alert"
  class="floating-promo-alert hidden"
  data-floating-promo
  aria-live="polite"
  role="status"
>
</aside>

<style is:global>
  .floating-promo-alert {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 55;
    width: min(92vw, 380px);
    pointer-events: auto;
  }

  .floating-promo-alert.hidden {
    display: none !important;
  }

  .floating-promo-alert.hidden-by-section,
  .floating-promo-alert.hidden-by-hero {
    opacity: 0 !important;
    pointer-events: none !important;
    transform: translateY(16px) scale(0.96) !important;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }

  .floating-promo-alert.is-visible {
    display: block;
    animation: alertSlideIn 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .floating-promo-alert .promo-alert-card {
    position: relative;
    padding: 1rem 1.15rem;
    border-radius: 20px;
    background: rgba(11, 18, 32, 0.94);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1.5px solid rgba(255, 196, 0, 0.45);
    box-shadow:
      0 18px 40px -12px rgba(0, 0, 0, 0.8),
      0 0 24px -6px rgba(255, 196, 0, 0.25),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
    color: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .floating-promo-alert .promo-alert-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .floating-promo-alert .promo-alert-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.22rem 0.65rem;
    border-radius: 9999px;
    background: rgba(255, 196, 0, 0.14);
    border: 1px solid rgba(255, 196, 0, 0.35);
  }

  .floating-promo-alert .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--yellow);
    box-shadow: 0 0 8px var(--yellow);
    animation: dotPulse 1.8s infinite ease-in-out;
  }

  @keyframes dotPulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.35;
      transform: scale(0.8);
    }
  }

  .floating-promo-alert .promo-alert-pill-text {
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--yellow);
  }

  .floating-promo-alert .promo-alert-close {
    width: 34px;
    height: 34px;
    min-width: 34px;
    min-height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--muted-on-dark);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease;
    flex-shrink: 0;
    padding: 0;
  }

  .floating-promo-alert .promo-alert-close:hover {
    background: rgba(255, 255, 255, 0.18);
    color: #ffffff;
    transform: scale(1.08);
  }

  .floating-promo-alert .promo-alert-body {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .floating-promo-alert .promo-alert-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: linear-gradient(135deg, var(--yellow), var(--yellow-soft));
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(255, 196, 0, 0.35);
  }

  .floating-promo-alert .promo-alert-content {
    flex: 1;
    min-width: 0;
  }

  .floating-promo-alert .promo-alert-headline {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.3;
  }

  .floating-promo-alert .promo-highlight {
    color: var(--yellow);
    font-weight: 800;
  }

  .floating-promo-alert .promo-alert-sub {
    margin: 0.2rem 0 0 0;
    font-size: 0.82rem;
    color: var(--muted-on-dark);
    line-height: 1.35;
  }

  .floating-promo-alert .promo-alert-sub strong {
    color: #ffffff;
  }

  .floating-promo-alert .promo-alert-footer {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .floating-promo-alert .promo-alert-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    width: 100%;
    min-height: 44px;
    padding: 0.55rem 1rem;
    border-radius: 9999px;
    background: var(--yellow);
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(255, 196, 0, 0.35);
    transition: transform 0.18s var(--ease-out), filter 0.18s var(--ease-out), box-shadow 0.18s var(--ease-out);
  }

  .floating-promo-alert .promo-alert-cta:hover {
    transform: translateY(-1px);
    filter: brightness(1.06);
    box-shadow: 0 6px 18px rgba(255, 196, 0, 0.45);
  }

  .floating-promo-alert .promo-alert-micro {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    color: var(--muted-on-dark);
    opacity: 0.85;
    text-align: center;
  }

  @keyframes alertSlideIn {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Ajustes responsivos para tablets e mobile */
  @media (max-width: 899px) {
    .floating-promo-alert {
      right: 0.75rem;
      left: 0.75rem;
      bottom: calc(4.8rem + env(safe-area-inset-bottom, 0px));
      width: calc(100vw - 1.5rem);
      max-width: none;
    }

    .floating-promo-alert .promo-alert-card {
      padding: 0.75rem 0.95rem;
      gap: 0.45rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-promo-alert.is-visible {
      animation: none !important;
    }
    .floating-promo-alert .pulse-dot {
      animation: none !important;
    }
  }
</style>
