---
/**
 * Header sticky institucional com dark glassmorphism e filete de marca Supletivo Brasil.
 * Acompanha a rolagem da página proporcionando navegação rápida e acesso imediato ao CTA.
 */
import Logo from './Logo.astro';
import { CTA_LABEL, CAREERS_URL } from '../config';
---

<header class="site-header" id="header">
  <div class="header-brand-rule" aria-hidden="true"></div>
  <div class="container site-header-inner">
    <div class="header-logo-wrap">
      <Logo variant="light" />
    </div>

    <nav class="site-nav" aria-label="Seções da página">
      <a href="#como-funciona">Como funciona</a>
      <a href="#elegibilidade">Requisitos</a>
      <a href="#depoimentos">Depoimentos</a>
      <a href="#preco">Preço</a>
      <a href="#faq">Dúvidas</a>
      <a
        href={CAREERS_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="site-nav-careers-mobile"
        aria-label="Trabalhe conosco como promotor ou polo parceiro (abre em nova aba)"
      >
        <span class="nav-beacon-dot" aria-hidden="true"></span>
        Trabalhe conosco
      </a>
    </nav>

    <div class="header-action">
      <a
        href={CAREERS_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="header-careers-btn"
        data-cta="header_careers"
        aria-label="Trabalhe conosco como promotor ou polo parceiro (abre em nova aba)"
      >
        <span class="careers-beacon" aria-hidden="true">
          <span class="beacon-pulse"></span>
          <span class="beacon-dot"></span>
        </span>
        <span class="careers-btn-text">Trabalhe conosco</span>
        <span class="careers-btn-tag">Renda Extra</span>
      </a>

      <a href="#preco" class="header-cta" data-cta="header">
        <span>{CTA_LABEL}</span>
        <span class="header-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    inset-inline: 0;
    z-index: 50;
    background-color: rgba(11, 18, 32, 0.94);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: none;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
    overflow-x: clip;
    padding-block: 0.75rem;
    padding-top: max(0.75rem, env(safe-area-inset-top));
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }

  /* Filete gradiente de assinatura de marca na borda inferior */
  .header-brand-rule {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background-image: linear-gradient(
      90deg,
      var(--green) 0%,
      var(--yellow) 50%,
      var(--blue) 100%
    );
    box-shadow: 0 1px 8px -2px var(--green);
    pointer-events: none;
    z-index: 2;
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .header-logo-wrap {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    margin-inline: auto;
  }

  .site-nav a {
    color: rgba(255, 255, 255, 0.85);
    font-weight: 600;
    font-size: 0.88rem;
    text-decoration: none;
    padding: 0.5rem 0.85rem;
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    transition: background-color 0.2s var(--ease-out), color 0.2s ease;
    white-space: nowrap;
  }

  .site-nav a:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.1);
  }

  .site-nav a:focus-visible {
    outline: 2px solid var(--yellow);
    outline-offset: 2px;
  }

  .header-action {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-shrink: 0;
  }

  /* Link Trabalhe Conosco no menu mobile */
  .site-nav-careers-mobile {
    display: none;
  }

  /* Botão Animado Trabalhe Conosco no Navbar */
  .header-careers-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.95rem;
    min-height: 48px;
    border-radius: 999px;
    background: rgba(0, 115, 77, 0.4);
    border: 1px solid rgba(0, 230, 153, 0.38);
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    overflow: clip;
    white-space: nowrap;
    box-shadow: none;
    transition: transform 0.2s var(--ease-out), border-color 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
  }

  /* Varredura luminosa contínua suave (Shine) */
  @media (prefers-reduced-motion: no-preference) {
    .header-careers-btn::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        105deg,
        transparent 35%,
        rgba(0, 230, 153, 0.35) 50%,
        rgba(255, 255, 255, 0.55) 53%,
        transparent 65%
      );
      transform: translateX(-140%) skewX(-12deg);
      animation: careers-btn-shimmer 4.8s var(--ease-out) infinite;
      pointer-events: none;
    }
  }

  @keyframes careers-btn-shimmer {
    0%, 65% {
      transform: translateX(-140%) skewX(-12deg);
    }
    100% {
      transform: translateX(140%) skewX(-12deg);
    }
  }

  .header-careers-btn:hover {
    transform: translateY(-1.5px);
    border-color: var(--yellow);
    background: linear-gradient(
      135deg,
      rgba(0, 115, 77, 0.35) 0%,
      rgba(18, 29, 51, 0.95) 100%
    );
    box-shadow: 0 8px 24px -4px rgba(0, 115, 77, 0.5), 0 0 12px 0 rgba(255, 196, 0, 0.3);
  }

  .header-careers-btn:active {
    transform: translateY(0) scale(0.99);
  }

  /* Beacon / Radar pulsante em verde neon */
  .careers-beacon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 10px;
    height: 10px;
    flex-shrink: 0;
  }

  .beacon-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background-color: #00e699;
    box-shadow: 0 0 6px #00e699;
  }

  .beacon-pulse {
    position: absolute;
    inset: -3px;
    border-radius: 999px;
    background-color: rgba(0, 230, 153, 0.5);
    animation: beacon-ping 2.2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes beacon-ping {
    0% {
      transform: scale(0.8);
      opacity: 0.95;
    }
    70%, 100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }

  .careers-btn-tag {
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
    background: rgba(255, 196, 0, 0.18);
    border: 1px solid rgba(255, 196, 0, 0.45);
    color: var(--yellow-soft);
    line-height: 1;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .header-careers-btn:hover .careers-btn-tag {
    background: var(--yellow);
    color: var(--ink);
    border-color: var(--yellow);
  }

  /* Em telas intermediárias (960px-1120px), esconde a tag para caber com conforto */
  @media (max-width: 1120px) {
    .careers-btn-tag {
      display: none;
    }
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.5rem 1.15rem;
    min-height: 48px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    text-decoration: none;
    transition: transform 0.18s var(--ease-out), background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    white-space: nowrap;
  }

  .header-cta:hover {
    background: rgba(255, 196, 0, 0.15);
    border-color: var(--yellow);
    color: var(--yellow);
    transform: translateY(-1px);
  }

  .header-arrow {
    transition: transform 0.18s var(--ease-out);
  }

  .header-cta:hover .header-arrow {
    transform: translateX(2px);
  }

  /* Em telas menores que 960px, ativa link Trabalhe Conosco no nav mobile com beacon */
  @media (max-width: 959px) {
    .header-action {
      display: none;
    }
    .site-nav {
      margin-left: auto;
      margin-inline: 0;
      overflow-x: auto;
      scrollbar-width: none;
      -ms-overflow-style: none;
      max-width: 100%;
    }
    .site-nav-careers-mobile {
      display: inline-flex !important;
      align-items: center;
      gap: 0.45rem;
      color: var(--yellow-soft) !important;
      background: rgba(0, 115, 77, 0.25) !important;
      border: 1px solid rgba(0, 230, 153, 0.35) !important;
      border-radius: 999px;
      font-weight: 700 !important;
    }
    .nav-beacon-dot {
      width: 7px;
      height: 7px;
      border-radius: 999px;
      background-color: #00e699;
      box-shadow: 0 0 6px #00e699;
      display: inline-block;
    }
  }

  /* Em mobile pequeno, links com rolagem horizontal suave mantendo ergonomia de toque */
  @media (max-width: 640px) {
    .site-header {
      padding-block: 0.4rem;
    }
    .site-nav {
      overflow-x: auto;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding-right: 0.5rem;
      gap: 0.1rem;
    }
    .site-nav::-webkit-scrollbar {
      display: none;
    }
    .site-nav a {
      font-size: 0.82rem;
      padding: 0.4rem 0.65rem;
    }
  }
</style>
