---
/**
 * Seção 8b — Rodapé: logo, CNPJ (placeholder), links legais, aviso LGPD.
 */
import Logo from './Logo.astro';
import { CAREERS_URL } from '../config';
import pkg from '../../package.json';

const year = new Date().getFullYear();
const version = pkg.version;
---

<footer class="footer on-dark">
  <div class="container">
    <p class="footer-tag">
      Feito para quem decidiu <span>voltar a estudar.</span>
    </p>

    <div class="footer-top">
      <div class="footer-brand">
        <Logo variant="light" />
        <!-- bandeirinha tremulando: assinatura de fechamento -->
        <svg class="footer-flag" viewBox="0 0 84 64" fill="none" aria-hidden="true">
          <rect x="4" y="2" width="4" height="60" rx="2" fill="#ffffff2b"></rect>
          <circle cx="6" cy="3" r="3" fill="var(--yellow)"></circle>
          <g class="ff-cloth">
            <rect x="8" y="6" width="62" height="40" rx="4" fill="var(--green)"></rect>
            <path d="M39 12l22 14-22 14-22-14z" fill="var(--yellow)"></path>
            <circle cx="39" cy="26" r="8.5" fill="var(--blue)"></circle>
            <path d="M35.5 26.2l2.8 2.8 5.2-5.6" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
          </g>
        </svg>
      </div>
      <nav aria-label="Conteúdo e links legais" class="footer-nav">
        <div class="footer-nav-group">
          <p class="footer-nav-title">Guias</p>
          <a href="/supletivo-online/">Supletivo Online</a>
          <a href="/eja-a-distancia/">EJA a Distância</a>
          <a href="/supletivo-ensino-fundamental/">Ensino Fundamental</a>
          <a href="/terminar-ensino-medio/">Terminar o Ensino Médio</a>
        </div>
        <div class="footer-nav-group">
          <p class="footer-nav-title">Legal</p>
          <a href="/termos/">Termos de Uso</a>
          <a href="/privacidade/">Política de Privacidade</a>
        </div>
        <div class="footer-nav-group footer-careers-group">
          <p class="footer-nav-title">Parceria</p>
          <a
            href={CAREERS_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="footer-careers-btn"
            aria-label="Trabalhe conosco como promotor ou polo parceiro (abre em nova aba)"
          >
            <span class="footer-careers-beacon" aria-hidden="true">
              <span class="beacon-pulse"></span>
              <span class="beacon-dot"></span>
            </span>
            <span class="footer-careers-text">Trabalhe conosco</span>
            <span class="footer-careers-badge">Renda Extra</span>
            <span class="footer-careers-arrow" aria-hidden="true">↗</span>
          </a>
          <p class="footer-careers-hint">Ganhe por indicação no Pix semanal</p>
        </div>
      </nav>
      <a class="to-top" href="#hero" aria-label="Voltar ao topo">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 19V5m-6 6 6-6 6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    <div class="footer-legal">
      <p>Supletivo Brasil · CNPJ 48.811.016/0001-00 · contato@supletivo.net.br</p>
      <p>
        O Supletivo Brasil atua como plataforma de captação, intermediação e matrícula acelerada para a Educação de Jovens e Adultos (EJA). Os cursos, aulas, tutoria e certificação são prestados e emitidos exclusivamente por instituição de ensino parceira autorizada pelo Conselho Estadual de Educação (CEE), amparada pela Lei Federal nº 9.394/96 (LDB), com publicação no Diário Oficial e validade em todo o território nacional.
      </p>
      <p>
        Respeitamos a sua privacidade: os dados informados na matrícula são
        usados apenas para a sua inscrição e comunicação sobre o curso,
        conforme a LGPD (Lei nº 13.709/2018).
      </p>
      <p class="footer-copy">
        © {year} Supletivo Brasil. Todos os direitos reservados.
        <span class="footer-version" title={`Versão da plataforma v${version}`}>v{version}</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: var(--muted-on-dark);
    padding-block: 3.6rem 2.6rem;
    font-size: 0.86rem;
    /* faixa tricolor: assinatura da bandeira fechando a página */
    border-top: 5px solid transparent;
    border-image: linear-gradient(
        90deg,
        var(--green) 0 34%,
        var(--yellow) 34% 67%,
        var(--blue) 67% 100%
      )
      1;
  }

  /* tagline de fechamento — a única frase grande do rodapé */
  .footer-tag {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.2vw, 2.05rem);
    line-height: 1.15;
    color: var(--paper);
    max-width: 28ch;
    margin-bottom: 2.4rem;
  }

  .footer-tag span {
    color: var(--yellow);
  }

  /* espaço para o sticky CTA não cobrir o rodapé no mobile */
  @media (max-width: 899px) {
    .footer {
      padding-bottom: 7rem;
    }
  }

  .footer-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.4rem;
    padding-bottom: 1.8rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }

  /* logo um degrau maior que o do header — assinatura de fechamento */
  .footer-top :global(.logo svg) {
    width: 40px;
    height: 40px;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  /* bandeirinha no mastro, ondulando de leve */
  .footer-flag {
    width: 52px;
    height: auto;
    overflow: visible;
  }

  .ff-cloth {
    transform-box: view-box;
    transform-origin: 8px 26px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ff-cloth {
      animation: ff-wave 4.5s ease-in-out infinite;
    }
  }

  @keyframes ff-wave {
    0%,
    100% {
      transform: skewY(0deg);
    }
    30% {
      transform: skewY(2.4deg) scaleX(0.985);
    }
    65% {
      transform: skewY(-1.8deg);
    }
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem clamp(2rem, 6vw, 4rem);
  }

  .footer-nav-group {
    display: grid;
    gap: 0.15rem;
    justify-items: start;
  }

  .footer-nav-title {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.6);
    margin-bottom: 0.35rem;
  }

  .footer-nav a {
    color: var(--paper);
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    /* área de toque ≥ 48px sem inflar o layout */
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding-block: 0.5rem;
  }

  .footer-nav a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* voltar ao topo: eco do scroll-cue do hero */
  .to-top {
    width: 3rem;
    height: 3rem;
    flex: none;
    display: grid;
    place-items: center;
    color: var(--paper);
    border: 1.5px solid rgb(255 255 255 / 0.3);
    border-radius: 50%;
    transition:
      transform 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out),
      color 0.2s var(--ease-out);
  }

  .to-top svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .to-top:hover {
    transform: translateY(-3px);
    border-color: var(--yellow);
    color: var(--yellow);
  }

  .to-top:focus-visible {
    outline: 3px solid var(--yellow);
    outline-offset: 3px;
  }

  .footer-legal {
    margin-top: 1.8rem;
    display: grid;
    gap: 0.7rem;
    max-width: 56ch;
  }

  .footer-copy {
    margin-top: 0.6rem;
  }

  .footer-version {
    margin-left: 0.5rem;
    font-family: monospace;
    font-size: 0.82rem;
    color: var(--muted-on-dark);
    letter-spacing: -0.02em;
    user-select: none;
  }

  /* Destaque do botão Trabalhe Conosco no Rodapé */
  .footer-careers-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .footer-careers-btn {
    display: inline-flex !important;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 1.15rem !important;
    min-height: 48px;
    border-radius: 999px;
    background: linear-gradient(
      135deg,
      rgba(0, 115, 77, 0.28) 0%,
      rgba(11, 18, 32, 0.85) 100%
    );
    border: 1px solid rgba(0, 230, 153, 0.45);
    color: #ffffff !important;
    font-size: 0.88rem !important;
    font-weight: 700 !important;
    text-decoration: none !important;
    box-shadow: 0 4px 16px -4px rgba(0, 115, 77, 0.4);
    position: relative;
    overflow: clip;
    transition: transform 0.2s var(--ease-out), border-color 0.2s ease, box-shadow 0.25s ease, background 0.2s ease !important;
  }

  @media (prefers-reduced-motion: no-preference) {
    .footer-careers-btn::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        105deg,
        transparent 35%,
        rgba(0, 230, 153, 0.35) 50%,
        rgba(255, 255, 255, 0.55) 53%,
        transparent 65%
      );
      transform: translateX(-140%) skewX(-12deg);
      animation: footer-careers-shimmer 5s var(--ease-out) infinite;
      pointer-events: none;
    }
  }

  @keyframes footer-careers-shimmer {
    0%, 70% {
      transform: translateX(-140%) skewX(-12deg);
    }
    100% {
      transform: translateX(140%) skewX(-12deg);
    }
  }

  .footer-careers-btn:hover {
    transform: translateY(-2px);
    border-color: var(--yellow);
    background: linear-gradient(
      135deg,
      rgba(0, 115, 77, 0.42) 0%,
      rgba(18, 29, 51, 0.95) 100%
    );
    box-shadow: 0 8px 24px -4px rgba(0, 115, 77, 0.6), 0 0 12px rgba(255, 196, 0, 0.35);
    text-decoration: none !important;
  }

  .footer-careers-beacon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 10px;
    height: 10px;
    flex-shrink: 0;
  }

  .footer-careers-beacon .beacon-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background-color: #00e699;
    box-shadow: 0 0 6px #00e699;
  }

  .footer-careers-beacon .beacon-pulse {
    position: absolute;
    inset: -3px;
    border-radius: 999px;
    background-color: rgba(0, 230, 153, 0.5);
    animation: footer-beacon-ping 2.2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes footer-beacon-ping {
    0% {
      transform: scale(0.8);
      opacity: 0.95;
    }
    70%, 100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }

  .footer-careers-badge {
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    background: rgba(255, 196, 0, 0.18);
    border: 1px solid rgba(255, 196, 0, 0.45);
    color: var(--yellow-soft);
    line-height: 1;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .footer-careers-btn:hover .footer-careers-badge {
    background: var(--yellow);
    color: var(--ink);
    border-color: var(--yellow);
  }

  .footer-careers-arrow {
    font-size: 0.9rem;
    color: var(--yellow-soft);
    transition: transform 0.18s var(--ease-out);
  }

  .footer-careers-btn:hover .footer-careers-arrow {
    transform: translate(2px, -2px);
  }

  .footer-careers-hint {
    font-size: 0.78rem;
    color: var(--muted-on-dark);
    margin: 0;
  }
</style>
