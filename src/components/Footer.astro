---
/**
 * Rodapé Institucional: Logo, links de navegação, guias, compliance legal e LGPD.
 * Padrão Editorial "Pátria Amada Refinada" em total conformidade com o DESIGN.md.
 */
import Logo from './Logo.astro';
import { CAREERS_URL, CONTACT_WHATSAPP } from '../config';

const year = new Date().getFullYear();
const waHref = CONTACT_WHATSAPP ? `https://wa.me/${CONTACT_WHATSAPP}` : null;
const waLabel = '(42) 9 8432-1915';
---

<footer class="footer on-dark">
  <div class="container">
    <p class="footer-tag">
      Feito para quem decidiu <span>voltar a estudar.</span>
    </p>

    <div class="footer-top">
      <div class="footer-brand">
        <Logo variant="light" />
        <!-- bandeirinha tremulando: assinatura de fechamento -->
        <svg class="footer-flag" viewBox="0 0 84 64" fill="none" aria-hidden="true">
          <rect x="4" y="2" width="4" height="60" rx="2" fill="rgba(255, 255, 255, 0.28)"></rect>
          <circle cx="6" cy="3" r="3" fill="var(--yellow)"></circle>
          <g class="ff-cloth">
            <rect x="8" y="6" width="62" height="40" rx="4" fill="var(--green)"></rect>
            <path d="M39 12l22 14-22 14-22-14z" fill="var(--yellow)"></path>
            <circle cx="39" cy="26" r="8.5" fill="var(--blue)"></circle>
            <path d="M35.5 26.2l2.8 2.8 5.2-5.6" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
          </g>
        </svg>
      </div>

      <nav aria-label="Navegação e links institucionais" class="footer-nav">
        <div class="footer-nav-group">
          <p class="footer-nav-title">O Supletivo</p>
          <ul class="footer-nav-list">
            <li><a href="/#como-funciona">Como funciona</a></li>
            <li><a href="/#validade">Validade nacional</a></li>
            <li><a href="/#preco">O investimento</a></li>
            <li><a href="/#duvidas">Dúvidas frequentes</a></li>
          </ul>
        </div>

        <div class="footer-nav-group">
          <p class="footer-nav-title">Guias</p>
          <ul class="footer-nav-list">
            <li><a href="/supletivo-online/">Supletivo Online</a></li>
            <li><a href="/eja-a-distancia/">EJA a Distância</a></li>
            <li><a href="/ensino-fundamental/">Ensino Fundamental</a></li>
            <li><a href="/terminar-ensino-medio/">Terminar o Ensino Médio</a></li>
          </ul>
        </div>

        <div class="footer-nav-group">
          <p class="footer-nav-title">Legal</p>
          <ul class="footer-nav-list">
            <li><a href="/termos/">Termos de Uso</a></li>
            <li><a href="/privacidade/">Política de Privacidade</a></li>
          </ul>
        </div>

        <div class="footer-nav-group footer-careers-group">
          <p class="footer-nav-title">Parceria</p>
          <ul class="footer-nav-list">
            <li>
              <a
                href={CAREERS_URL}
                target="_blank"
                rel="noopener"
                class="footer-careers-btn"
                aria-label="Trabalhe conosco como promotor ou polo parceiro (abre em nova aba)"
              >
                <span class="footer-careers-beacon" aria-hidden="true">
                  <span class="beacon-pulse"></span>
                  <span class="beacon-dot"></span>
                </span>
                <span class="footer-careers-text">Trabalhe conosco</span>
                <span class="footer-careers-badge">Promotores</span>
                <span class="footer-careers-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          </ul>
          <p class="footer-careers-hint">Programa oficial de promotores e polos</p>
        </div>
      </nav>

      <a class="to-top" href="#hero" aria-label="Voltar ao topo da página">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 19V5m-6 6 6-6 6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    <!-- Pílulas de Confiança e Validade Legal (Zero Slop / Estilo Editorial) -->
    <div class="footer-trust-bar" aria-label="Garantias e conformidade legal">
      <div class="trust-pill">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        <span>Amparado pela Lei Federal nº 9.394/96 (LDB)</span>
      </div>
      <div class="trust-pill">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        <span>Publicação em Diário Oficial</span>
      </div>
      <div class="trust-pill">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        <span>Certificado Válido em Todo o Território Nacional</span>
      </div>
      <div class="trust-pill">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <span>Segurança e Privacidade (LGPD)</span>
      </div>
    </div>

    <div class="footer-legal">
      <address class="footer-address">
        <div class="footer-entity">
          <span class="footer-entity-brand">Supletivo Brasil</span>
          <span class="footer-sep" aria-hidden="true">·</span>
          <span>CNPJ 48.811.016/0001-00</span>
        </div>
        <div class="footer-contact-pills">
          <a href="mailto:contato@supletivo.net.br" class="footer-pill-link">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            <span>contato@supletivo.net.br</span>
          </a>
          <a href={waHref || 'https://wa.me/5542984321915'} target="_blank" rel="noopener" class="footer-pill-link">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
            <span>WhatsApp {waLabel}</span>
          </a>
        </div>
      </address>

      <div class="footer-disclaimers">
        <p>
          O Supletivo Brasil atua como plataforma de captação, intermediação e matrícula acelerada para a Educação de Jovens e Adultos (EJA). Os cursos, aulas, tutoria e certificação são prestados e emitidos exclusivamente por <strong>instituição de ensino parceira autorizada pelo Conselho Estadual de Educação (CEE)</strong>, amparada pela <strong>Lei Federal nº 9.394/96 (LDB)</strong>, com publicação no Diário Oficial e validade em todo o território nacional.
        </p>
        <p>
          Respeitamos a sua privacidade: os dados informados na matrícula são usados apenas para a sua inscrição e comunicação sobre o curso, conforme a <strong>LGPD (Lei nº 13.709/2018)</strong>.
        </p>
      </div>

      <p class="footer-copy">
        © <time datetime={`${year}`}>{year}</time> Supletivo Brasil. Todos os direitos reservados.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: var(--muted-on-dark);
    padding-block: 3.6rem 2.6rem;
    font-size: 0.86rem;
    /* faixa tricolor de alta precisão (3px) fechando a página */
    border-top: 3px solid transparent;
    border-image: linear-gradient(
        90deg,
        var(--green) 0 34%,
        var(--yellow) 34% 67%,
        var(--blue) 67% 100%
      )
      1;
  }

  /* Tagline de fechamento */
  .footer-tag {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.2vw, 2.05rem);
    line-height: 1.15;
    color: var(--paper);
    max-width: 28ch;
    margin-bottom: clamp(1.5rem, 3vw, 2.4rem);
  }

  .footer-tag span {
    color: var(--yellow);
  }

  /* Sincronização rigorosa com o Sticky CTA (apenas < 768px) */
  @media (max-width: 767px) {
    .footer {
      padding-bottom: calc(5.2rem + env(safe-area-inset-bottom, 0px));
    }
  }

  .footer-top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem 1.4rem;
    padding-bottom: 2.4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Assinatura visual do logo no rodapé */
  .footer-top :global(.logo svg) {
    width: 40px;
    height: 40px;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  /* bandeirinha no mastro com física suave */
  .footer-flag {
    width: 52px;
    height: auto;
    overflow: visible;
  }

  .ff-cloth {
    transform-box: view-box;
    transform-origin: 8px 26px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ff-cloth {
      animation: ff-wave 4.5s ease-in-out infinite;
    }
  }

  @keyframes ff-wave {
    0%,
    100% {
      transform: skewY(0deg);
    }
    30% {
      transform: skewY(2.4deg) scaleX(0.985);
    }
    65% {
      transform: skewY(-1.8deg);
    }
  }

  /* Grade de links de navegação */
  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem clamp(1.8rem, 4vw, 3.2rem);
  }

  .footer-nav-group {
    display: grid;
    gap: 0.15rem;
    justify-items: start;
  }

  .footer-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.1rem;
  }

  .footer-nav-title {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-on-dark);
    margin-bottom: 0.4rem;
  }

  .footer-nav a {
    color: var(--paper);
    font-weight: 500;
    font-size: 0.92rem;
    text-decoration: none;
    /* Área de toque padrão ≥ 48px */
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding-block: 0.25rem;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }

  .footer-nav a:hover {
    color: var(--yellow);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Anel de foco acessível WCAG */
  .footer-nav a:focus-visible,
  .footer-pill-link:focus-visible,
  .to-top:focus-visible,
  .footer-careers-btn:focus-visible {
    outline: 2px solid var(--yellow);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* Voltar ao topo */
  .to-top {
    width: 3rem;
    height: 3rem;
    min-width: 48px;
    min-height: 48px;
    flex: none;
    display: grid;
    place-items: center;
    color: var(--paper);
    border: 1.5px solid rgba(255, 255, 255, 0.25);
    border-radius: 50%;
    transition:
      transform 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out),
      color 0.2s var(--ease-out),
      background-color 0.2s var(--ease-out);
  }

  .to-top svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .to-top:hover {
    transform: translateY(-3px);
    border-color: var(--yellow);
    color: var(--yellow);
    background: rgba(255, 255, 255, 0.04);
  }

  /* Destaque Institucional Trabalhe Conosco (Sem !important e Sem Ruído Visual) */
  .footer-careers-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .footer-nav .footer-careers-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 1rem;
    min-height: 48px;
    border-radius: 999px;
    background: rgba(0, 115, 77, 0.35);
    border: 1px solid rgba(0, 230, 153, 0.45);
    color: #ffffff;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: none;
    position: relative;
    overflow: hidden;
    transition:
      transform 0.2s var(--ease-out),
      border-color 0.2s ease,
      box-shadow 0.25s ease,
      background-color 0.2s ease;
  }

  .footer-nav .footer-careers-btn:hover {
    transform: translateY(-2px);
    border-color: var(--yellow);
    background: rgba(0, 115, 77, 0.55);
    box-shadow: 0 4px 16px -4px rgba(0, 115, 77, 0.6);
    color: #ffffff;
    text-decoration: none;
  }

  .footer-careers-beacon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 8px;
    height: 8px;
    flex-shrink: 0;
  }

  .footer-careers-beacon .beacon-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #00e699;
    box-shadow: 0 0 6px #00e699;
  }

  .footer-careers-beacon .beacon-pulse {
    display: none; /* remove pulso constante para elegância editorial */
  }

  .footer-careers-badge {
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    background: rgba(255, 196, 0, 0.18);
    border: 1px solid rgba(255, 196, 0, 0.45);
    color: var(--yellow-soft);
    line-height: 1;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .footer-nav .footer-careers-btn:hover .footer-careers-badge {
    background: var(--yellow);
    color: var(--ink);
    border-color: var(--yellow);
  }

  .footer-careers-arrow {
    font-size: 0.88rem;
    color: var(--yellow-soft);
    transition: transform 0.18s var(--ease-out);
  }

  .footer-nav .footer-careers-btn:hover .footer-careers-arrow {
    transform: translate(2px, -2px);
  }

  .footer-careers-hint {
    font-size: 0.8rem;
    color: var(--muted-on-dark);
    margin: 0;
  }

  /* Barra de Pílulas de Confiança (Trust Pills Bar) */
  .footer-trust-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    padding-block: 1.4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .trust-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.8rem;
    color: var(--paper);
    letter-spacing: 0.01em;
  }

  .trust-pill svg {
    color: var(--yellow);
    flex-shrink: 0;
  }

  /* Bloco Legal e Contatos */
  .footer-legal {
    margin-top: 1.8rem;
    display: grid;
    gap: 1rem;
    max-width: 68ch;
  }

  .footer-address {
    font-style: normal;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1.4rem;
  }

  .footer-entity {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--paper);
    font-weight: 600;
  }

  .footer-entity-brand {
    color: var(--paper);
  }

  .footer-sep {
    color: var(--muted-on-dark);
  }

  .footer-contact-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .footer-pill-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 48px;
    padding: 0.35rem 0.75rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--paper);
    text-decoration: none;
    font-size: 0.84rem;
    font-weight: 500;
    transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
  }

  .footer-pill-link svg {
    color: var(--yellow);
    flex-shrink: 0;
  }

  .footer-pill-link:hover {
    border-color: var(--yellow);
    background: rgba(255, 255, 255, 0.07);
    color: var(--yellow);
  }

  .footer-disclaimers {
    display: grid;
    gap: 0.6rem;
    line-height: 1.6;
    font-size: 0.84rem;
  }

  .footer-disclaimers strong {
    color: var(--paper);
    font-weight: 600;
  }

  .footer-copy {
    margin-top: 0.4rem;
    font-size: 0.82rem;
    color: var(--muted-on-dark);
  }

  @media (max-width: 480px) {
    .footer-top {
      flex-direction: column;
      align-items: stretch;
      gap: 1.8rem;
    }

    .footer-brand {
      justify-content: space-between;
    }

    .to-top {
      align-self: flex-end;
    }
  }
</style>
