---
/**
 * LeadCaptureModal.astro
 * Captura Inteligente de Alunos (Zero-Friction Lead Capture).
 * Sofia Smart Omnibar, validação matemática e Credencial 3D.
 * Componentizado e enxuto via Ponytail.
 */
import { APP_URL, BACKEND_URL } from '../config';
import SofiaPresence from './SofiaPresence.astro';
import CredentialCard from './CredentialCard.astro';
---

<div
  id="lead-capture-modal"
  class="lead-modal-backdrop"
  role="dialog"
  aria-modal="true"
  aria-labelledby="lead-modal-title"
  aria-hidden="true"
  hidden
  inert
  data-lead-capture-modal
  data-app-url={APP_URL}
  data-backend-url={BACKEND_URL}
>
  <div class="lead-modal-overlay" data-close-modal></div>

  <div class="lead-modal-container">
    <!-- Drag Handle tátil mobile -->
    <div class="drag-handle-bar md:hidden" aria-hidden="true">
      <div class="drag-pill"></div>
    </div>

    <!-- Botão de Fechar -->
    <button
      type="button"
      class="close-btn"
      aria-label="Fechar janela de inscrição"
      data-close-modal
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="lead-modal-layout">
      <!-- Coluna Principal: Sofia + Omnibar + Etapas -->
      <div class="interaction-col">
        <SofiaPresence />

        <!-- Breadcrumbs Vivos -->
        <div id="lead-breadcrumbs" class="lead-breadcrumbs hidden" aria-label="Progresso do formulário">
          <button type="button" class="pill-chip" id="chip-phone" title="Clique para editar o telefone" aria-label="Voltar para editar WhatsApp">
            <span class="chip-icon">💬</span>
            <span class="chip-label" id="chip-phone-text">(11) 98765-4321</span>
            <span class="chip-edit">✏️</span>
          </button>
          <button type="button" class="pill-chip hidden" id="chip-cpf" title="Clique para editar o CPF" aria-label="Voltar para editar CPF">
            <span class="chip-icon">🪪</span>
            <span class="chip-label" id="chip-cpf-text">000.000.000-00</span>
            <span class="chip-edit">✏️</span>
          </button>
        </div>

        <!-- Formulário Dinâmico Omnibar Zero-Button -->
        <form id="lead-capture-form" class="omnibar-form" novalidate>
          <!-- ETAPA 1: WHATSAPP -->
          <div id="step-phone" class="step-pane active">
            <div class="input-wrapper" id="phone-wrapper">
              <span class="input-icon whatsapp-icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                </svg>
              </span>
              <input
                type="tel"
                id="lead-input-phone"
                class="omnibar-input"
                placeholder="(DD) 9XXXX-XXXX"
                inputmode="numeric"
                autocomplete="tel-national"
                maxlength="15"
                required
                aria-label="Número do seu celular WhatsApp"
              />
              <span class="input-status-icon" id="phone-status-icon" aria-hidden="true">
                <svg class="check-svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="3">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span class="spinner" id="phone-spinner" aria-hidden="true"></span>
              </span>
            </div>
            <p class="input-hint" id="phone-hint">
              Digite seu WhatsApp com DDD. Validação e avanço imediatos ao digitar.
            </p>
          </div>

          <!-- ETAPA 2: CPF (MÓDULO 11) -->
          <div id="step-cpf" class="step-pane hidden">
            <div class="input-wrapper" id="cpf-wrapper">
              <span class="input-icon" aria-hidden="true">🪪</span>
              <input
                type="tel"
                id="lead-input-cpf"
                class="omnibar-input"
                placeholder="000.000.000-00"
                inputmode="numeric"
                autocomplete="off"
                maxlength="14"
                aria-label="Número do seu CPF"
              />
              <span class="input-status-icon" id="cpf-status-icon" aria-hidden="true">
                <svg class="check-svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="3">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span class="spinner" id="cpf-spinner" aria-hidden="true"></span>
              </span>
            </div>
            <p class="input-hint" id="cpf-hint">
              Validação cadastral oficial e elegibilidade legal pela LDB.
            </p>
          </div>

          <!-- ETAPA 3: E-MAIL (AUTO-DISPATCH) -->
          <div id="step-email" class="step-pane hidden">
            <div class="input-wrapper" id="email-wrapper">
              <span class="input-icon" aria-hidden="true">✉️</span>
              <input
                type="email"
                id="lead-input-email"
                class="omnibar-input"
                placeholder="seu@email.com"
                inputmode="email"
                autocomplete="email"
                aria-label="Seu melhor endereço de e-mail"
              />
              <span class="input-status-icon" id="email-status-icon" aria-hidden="true">
                <svg class="check-svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="3">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span class="spinner" id="lead-spinner" aria-hidden="true"></span>
              </span>
            </div>
            <p class="input-hint" id="email-hint">
              Digite seu e-mail para receber a cópia oficial do plano acelerado.
            </p>
            <div class="email-domain-chips" id="email-domain-chips" aria-label="Provedores rápidos de e-mail">
              <button type="button" class="domain-chip" data-domain="gmail.com">@gmail.com</button>
              <button type="button" class="domain-chip" data-domain="hotmail.com">@hotmail.com</button>
              <button type="button" class="domain-chip" data-domain="outlook.com">@outlook.com</button>
              <button type="button" class="domain-chip" data-domain="yahoo.com.br">@yahoo.com.br</button>
            </div>
          </div>

          <!-- ESTADO: CPF COM OUTRO TELEFONE LOCALIZADO -->
          <div id="step-existing" class="step-pane hidden">
            <div class="existing-user-card">
              <div class="existing-badge">
                <span class="star-icon">★</span>
                Matrícula Localizada
              </div>
              <p class="existing-text">
                Identificamos seu cadastro seguro vinculado ao celular com final
                <strong id="existing-phone-masked">(XX) •••••-XXXX</strong>.
              </p>
              <p class="existing-sub">
                Enviamos o código de segurança para o seu número cadastrado. Redirecionando para autenticação...
              </p>
              <div class="existing-progress-wrap" aria-hidden="true">
                <div class="existing-progress-bar" id="existing-progress-bar"></div>
              </div>
              <p class="existing-redirect-info">
                Redirecionamento automático em <span id="existing-countdown">3</span>s
                · <a href="#" id="btn-existing-redirect" class="existing-inline-link">Acessar agora &rarr;</a>
              </p>
            </div>
          </div>
        </form>

        <div class="security-footer">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span>Ambiente Criptografado de Conclusão · Escola Autorizada CEE / LDB nº 9.394/96</span>
        </div>
      </div>

      <!-- Coluna Visual: The Credential Forger (3D Holographic Card) -->
      <div class="visual-col hidden md:flex">
        <CredentialCard />
      </div>
    </div>
  </div>
</div>

<style>
  #lead-breadcrumbs.hidden,
  .spinner.hidden,
  .step-pane.hidden,
  .pill-chip.hidden {
    display: none;
  }

  .lead-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: flex-end;
    justify-content: center;
    background: rgba(3, 7, 18, 0.82);
    backdrop-filter: blur(14px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.28s ease, backdrop-filter 0.28s ease;
  }

  .lead-modal-backdrop.open {
    display: flex;
    opacity: 1;
    pointer-events: auto;
  }

  .lead-modal-overlay {
    position: absolute;
    inset: 0;
    cursor: pointer;
  }

  .lead-modal-container {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 54rem;
    max-height: 94dvh;
    background: linear-gradient(180deg, var(--ink-soft) 0%, var(--ink) 100%);
    border: 1px solid var(--glass-border-dark);
    box-shadow: var(--shadow-floating), 0 0 40px color-mix(in srgb, var(--blue) 25%, transparent);
    border-top-left-radius: 1.75rem;
    border-top-right-radius: 1.75rem;
    padding: 1.5rem 1.5rem calc(1.5rem + env(safe-area-inset-bottom, 0px));
    transform: translateY(100%);
    transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
    overflow-y: auto;
  }

  .lead-modal-backdrop.open .lead-modal-container {
    transform: translateY(0);
  }

  @media (min-width: 768px) {
    .lead-modal-backdrop {
      align-items: center;
      padding: 1.5rem;
    }
    .lead-modal-container {
      border-radius: 1.5rem;
      transform: scale(0.96) translateY(20px);
      padding: 2.25rem;
    }
    .lead-modal-backdrop.open .lead-modal-container {
      transform: scale(1) translateY(0);
    }
  }

  /* Drag handle mobile */
  .drag-handle-bar {
    display: flex;
    justify-content: center;
    margin-bottom: 0.75rem;
  }
  .drag-pill {
    width: 2.75rem;
    height: 0.28rem;
    background: rgba(255, 255, 255, 0.25);
    border-radius: 999px;
  }

  /* Fechar */
  .close-btn {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--muted-on-dark);
    width: 3rem;
    height: 3rem;
    min-width: 48px;
    min-height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
  }
  .close-btn:hover {
    background: rgba(255, 255, 255, 0.16);
    color: #ffffff;
    transform: rotate(90deg);
  }

  /* Layout */
  .lead-modal-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .lead-modal-layout {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }

  /* Chips genéricos (Breadcrumbs & Domain Chips) */
  .lead-breadcrumbs,
  .email-domain-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .email-domain-chips {
    margin-top: 0.75rem;
    margin-bottom: 0;
  }

  .pill-chip,
  .domain-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    padding: 0.45rem 0.9rem;
    min-height: var(--input-height, 48px);
    color: var(--muted-on-dark);
    font-size: 0.84rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }
  .pill-chip:hover,
  .domain-chip:hover {
    background: color-mix(in srgb, var(--yellow) 15%, transparent);
    border-color: var(--yellow);
    color: #ffffff;
  }

  /* Omnibar Form */
  .omnibar-form {
    position: relative;
    margin-bottom: 1.25rem;
  }

  .step-pane {
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    background: var(--ink-soft);
    border: 2px solid var(--glass-border-dark);
    border-radius: var(--input-radius, 10px);
    padding: 0.2rem 1rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .input-wrapper:focus-within {
    border-color: var(--yellow);
    box-shadow: 0 0 20px color-mix(in srgb, var(--yellow) 25%, transparent);
  }

  .input-wrapper.valid {
    border-color: var(--success);
    box-shadow: 0 0 20px color-mix(in srgb, var(--success) 25%, transparent);
  }

  .input-icon {
    font-size: 1.25rem;
    margin-right: 0.75rem;
    color: var(--muted-on-dark);
    display: flex;
    align-items: center;
  }
  .whatsapp-icon {
    color: var(--success);
  }

  .omnibar-input {
    width: 100%;
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    min-height: var(--input-height, 48px);
    height: var(--input-height, 48px);
    padding: 0;
    outline: none;
    font-family: inherit;
  }

  .omnibar-input::placeholder {
    color: color-mix(in srgb, var(--muted-on-dark) 60%, transparent);
    font-weight: 500;
  }

  .input-status-icon {
    position: relative;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: scale(0.7);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .input-wrapper.valid .input-status-icon,
  .input-wrapper.loading .input-status-icon {
    opacity: 1;
    transform: scale(1);
  }
  .input-status-icon .check-svg,
  .input-status-icon .spinner {
    display: none;
  }
  .input-wrapper.loading .input-status-icon .spinner {
    display: inline-block;
  }
  .input-wrapper.loading .input-status-icon .check-svg {
    display: none;
  }
  .input-wrapper.valid:not(.loading) .input-status-icon .check-svg {
    display: inline-block;
  }

  .input-hint {
    font-size: 0.78rem;
    color: var(--muted-on-dark);
    margin-top: 0.5rem;
    line-height: 1.4;
  }

  /* Cartão de usuário já existente */
  .existing-user-card {
    background: color-mix(in srgb, var(--green) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--green) 35%, transparent);
    border-radius: var(--input-radius, 10px);
    padding: 1.5rem 1.25rem;
    text-align: center;
  }
  .existing-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--green);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    margin-bottom: 0.65rem;
  }
  .existing-text {
    color: #f1f5f9;
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
  }
  .existing-sub {
    color: var(--muted-on-dark);
    font-size: 0.82rem;
    margin-bottom: 1rem;
    line-height: 1.45;
  }
  .existing-progress-wrap {
    width: 100%;
    height: 5px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    overflow: hidden;
    margin: 0.75rem 0;
  }
  .existing-progress-bar {
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, var(--green) 0%, var(--yellow) 100%);
    transform-origin: left;
    transform: scaleX(1);
    transition: transform 2.8s linear;
  }
  .existing-redirect-info {
    font-size: 0.78rem;
    color: var(--muted-on-dark);
    margin-top: 0.6rem;
    margin-bottom: 0;
  }
  .existing-inline-link {
    color: var(--yellow);
    text-decoration: underline;
    font-weight: 700;
    transition: color 0.15s;
  }
  .existing-inline-link:hover {
    color: #ffffff;
  }

  .security-footer {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    color: var(--muted-on-dark);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 0.85rem;
  }

  /* Spinner */
  .spinner {
    width: 1.1rem;
    height: 1.1rem;
    border: 2px solid rgba(255, 255, 255, 0.22);
    border-top-color: var(--yellow);
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
    display: inline-block;
    box-sizing: border-box;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

<script>
  import { validateCPF, formatCPF } from '../scripts/cpf-validator';
  import { validatePhone, formatPhone } from '../scripts/phone-validator';
  import { isEmailFormatValid, completeEmailWithDomain } from '../lib/email';
  import { initAttribution, cookieDomain } from '../scripts/attribution';
  import { track } from '../scripts/track';

  const modal = document.querySelector<HTMLElement>('[data-lead-capture-modal]');
  if (modal) {
    const appUrl = modal.dataset.appUrl?.replace(/\/+$/, '') ?? 'https://app.supletivo.net.br';
    const closeTriggers = modal.querySelectorAll('[data-close-modal]');
    const speech = modal.querySelector<HTMLElement>('#lead-modal-title');
    const breadcrumbs = modal.querySelector<HTMLElement>('#lead-breadcrumbs');
    const chipPhone = modal.querySelector<HTMLElement>('#chip-phone');
    const chipPhoneText = modal.querySelector<HTMLElement>('#chip-phone-text');
    const chipCpf = modal.querySelector<HTMLElement>('#chip-cpf');
    const chipCpfText = modal.querySelector<HTMLElement>('#chip-cpf-text');

    const stepPhone = modal.querySelector<HTMLElement>('#step-phone');
    const stepCpf = modal.querySelector<HTMLElement>('#step-cpf');
    const stepEmail = modal.querySelector<HTMLElement>('#step-email');
    const stepExisting = modal.querySelector<HTMLElement>('#step-existing');

    const inputPhone = modal.querySelector<HTMLInputElement>('#lead-input-phone');
    const inputCpf = modal.querySelector<HTMLInputElement>('#lead-input-cpf');
    const inputEmail = modal.querySelector<HTMLInputElement>('#lead-input-email');
    const phoneWrapper = inputPhone?.closest('.input-wrapper');
    const cpfWrapper = inputCpf?.closest('.input-wrapper');
    const emailWrapper = inputEmail?.closest('.input-wrapper');

    // Elementos da Credencial 3D
    const credentialLed = modal.querySelector<HTMLElement>('#credential-led');
    const credentialDoc = modal.querySelector<HTMLElement>('#credential-student-doc');
    const credentialStudentName = modal.querySelector<HTMLElement>('#credential-student-name');
    const credentialStatusBadge = modal.querySelector<HTMLElement>('#credential-status-badge');
    const credentialStatusText = modal.querySelector<HTMLElement>('#credential-status-text');

    let isCheckingPhone = false;
    let isCheckingCpf = false;
    let isSubmitting = false;
    let lastCheckedPhone = '';
    let lastCheckedCpf = '';
    let emailDebounceTimer: ReturnType<typeof setTimeout> | null = null;
    let existingTimer: ReturnType<typeof setTimeout> | null = null;
    let existingInterval: ReturnType<typeof setInterval> | null = null;

    function clearTimers() {
      if (emailDebounceTimer) { clearTimeout(emailDebounceTimer); emailDebounceTimer = null; }
      if (existingTimer) { clearTimeout(existingTimer); existingTimer = null; }
      if (existingInterval) { clearInterval(existingInterval); existingInterval = null; }
    }

    // ── DRY HELPERS (PONYTAIL) ────────────────────────────────────────────────
    async function checkAuth(payload: Record<string, unknown>) {
      const backendUrl = modal?.dataset.backendUrl?.replace(/\/+$/, '') ?? 'https://backend.supletivo.net.br';
      const attr = initAttribution();
      try {
        const res = await fetch(`${backendUrl}/api/v1/clients/auth/check`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            send_otp: true,
            promotor: attr?.ref || undefined,
            ref: attr?.ref || undefined,
            attribution: attr ? {
              ref: attr.ref,
              utm_source: attr.utm_source,
              utm_medium: attr.utm_medium,
              utm_campaign: attr.utm_campaign,
              gclid: attr.gclid,
              fbclid: attr.fbclid,
            } : undefined,
            ...payload,
          }),
          signal: AbortSignal.timeout(3500),
        });
        return res.ok ? await res.json() : null;
      } catch (err) {
        console.warn('[lead-capture] Falha ou timeout no checkAuth:', err);
        return null;
      }
    }

    function saveSession(data: Record<string, unknown>) {
      const attr = initAttribution();
      const sessionPayload = JSON.stringify({
        ...data,
        ref: attr?.ref,
        ts: Date.now(),
      });
      document.cookie = `supletivo.session=${encodeURIComponent(sessionPayload)}; path=/; max-age=1800; SameSite=Lax${cookieDomain()}`;
    }

    function redirectToOtp(params: { id?: string; tel?: string; cpf?: string; email?: string; ref?: string }, delayMs = 0) {
      const attr = initAttribution();
      const targetUrl = new URL(`${appUrl}/autenticacao/otp`);
      if (params.id) targetUrl.searchParams.set('id', params.id);
      if (params.tel) targetUrl.searchParams.set('tel', params.tel);
      if (params.cpf) targetUrl.searchParams.set('cpf', params.cpf);
      if (params.email) targetUrl.searchParams.set('email', params.email);
      const effectiveRef = params.ref || attr?.ref;
      if (effectiveRef) targetUrl.searchParams.set('ref', effectiveRef);

      if (delayMs > 0) {
        setTimeout(() => { window.location.href = targetUrl.toString(); }, delayMs);
      } else {
        window.location.href = targetUrl.toString();
      }
    }

    // ── ABERTURA E FECHAMENTO ─────────────────────────────────────────────────
    function openModal(triggerSource = 'desconhecido') {
      modal?.removeAttribute('hidden');
      modal?.removeAttribute('inert');
      modal?.classList.add('open');
      modal?.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      track('lead_capture_opened', { source: triggerSource });
      setTimeout(() => { inputPhone?.focus(); }, 150);
    }

    function closeModal() {
      clearTimers();
      modal?.classList.remove('open');
      modal?.setAttribute('aria-hidden', 'true');
      modal?.setAttribute('hidden', '');
      modal?.setAttribute('inert', '');
      document.body.style.overflow = '';
    }

    closeTriggers.forEach((btn) => btn.addEventListener('click', closeModal));
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal?.classList.contains('open')) closeModal();
    });

    window.addEventListener('sb:open-lead-capture', (e: Event) => {
      const detail = (e as CustomEvent).detail;
      openModal(detail?.position ?? 'cta');
    });

    // ── ETAPA 1: WHATSAPP ────────────────────────────────────────────────────
    async function checkAndSubmitPhone(digits: string) {
      if (isCheckingPhone || digits === lastCheckedPhone) return;
      lastCheckedPhone = digits;
      isCheckingPhone = true;

      phoneWrapper?.classList.add('loading');
      phoneWrapper?.classList.remove('valid');

      const data = await checkAuth({ phone: digits, contato: digits });
      phoneWrapper?.classList.remove('loading');
      isCheckingPhone = false;

      // Se telefone já existe no banco: OTP enviado -> direto pro app!
      if (data?.found) {
        phoneWrapper?.classList.add('valid');
        credentialLed?.classList.add('verified');
        if (speech) {
          speech.textContent = 'Que bom ter você de volta! Localizamos seu cadastro e enviamos seu código no WhatsApp. Redirecionando...';
        }
        saveSession({ phone: digits });
        track('lead_phone_existing', { phone: digits });
        redirectToOtp({ id: data.external_id, tel: digits }, 500);
        return;
      }

      // Telefone novo: auto-avança para CPF
      phoneWrapper?.classList.add('valid');
      credentialLed?.classList.add('verified');
      advanceToCpfStep();
    }

    function handlePhoneInput() {
      if (!inputPhone) return;
      const digits = inputPhone.value.replace(/\D/g, '');
      inputPhone.value = formatPhone(digits);

      const isValid = validatePhone(digits);
      phoneWrapper?.classList.toggle('valid', isValid);

      if (isValid && digits.length === 11) {
        checkAndSubmitPhone(digits);
      } else {
        lastCheckedPhone = '';
        credentialLed?.classList.remove('verified');
      }
    }

    function advanceToCpfStep() {
      if (!inputPhone || !validatePhone(inputPhone.value)) return;

      stepPhone?.classList.add('hidden');
      stepCpf?.classList.remove('hidden');
      stepEmail?.classList.add('hidden');
      stepExisting?.classList.add('hidden');

      if (breadcrumbs && chipPhoneText) {
        breadcrumbs.classList.remove('hidden');
        chipPhone?.classList.remove('hidden');
        chipPhoneText.textContent = inputPhone.value;
        chipCpf?.classList.add('hidden');
      }

      if (speech) {
        speech.textContent = 'Agora digite seu CPF para validação cadastral e elegibilidade legal pela LDB.';
      }

      setTimeout(() => { inputCpf?.focus(); }, 50);
    }

    inputPhone?.addEventListener('input', handlePhoneInput);

    // Navegação reversa via chips
    chipPhone?.addEventListener('click', () => {
      clearTimers();
      stepCpf?.classList.add('hidden');
      stepEmail?.classList.add('hidden');
      stepExisting?.classList.add('hidden');
      stepPhone?.classList.remove('hidden');
      breadcrumbs?.classList.add('hidden');
      if (speech) {
        speech.textContent = 'Olá! Para onde te envio seu plano acelerado e a confirmação da sua pré-matrícula?';
      }
      inputPhone?.focus();
    });

    chipCpf?.addEventListener('click', () => {
      clearTimers();
      stepEmail?.classList.add('hidden');
      stepPhone?.classList.add('hidden');
      stepExisting?.classList.add('hidden');
      stepCpf?.classList.remove('hidden');
      chipCpf?.classList.add('hidden');
      if (speech) {
        speech.textContent = 'Agora digite seu CPF para validação cadastral e elegibilidade legal pela LDB.';
      }
      inputCpf?.focus();
    });

    // ── ETAPA 2: CPF ──────────────────────────────────────────────────────────
    async function checkAndSubmitCpf(digits: string) {
      if (isCheckingCpf || digits === lastCheckedCpf) return;
      lastCheckedCpf = digits;
      isCheckingCpf = true;

      cpfWrapper?.classList.add('loading');
      cpfWrapper?.classList.remove('valid');

      const phoneDigits = inputPhone?.value.replace(/\D/g, '') ?? '';
      const data = await checkAuth({ cpf: digits, phone: phoneDigits });
      cpfWrapper?.classList.remove('loading');
      isCheckingCpf = false;

      if (data?.found) {
        const cleanMasked = (data?.masked_phone || '').replace(/\D/g, '');
        const isDifferentPhone = Boolean(
          cleanMasked &&
          cleanMasked.length >= 4 &&
          phoneDigits.length >= 4 &&
          !phoneDigits.endsWith(cleanMasked.slice(-4)) &&
          !cleanMasked.endsWith(phoneDigits.slice(-4))
        );

        if (isDifferentPhone) {
          showExistingCard(data, digits, phoneDigits);
          return;
        }

        redirectToOtp({ id: data.external_id, tel: phoneDigits, cpf: digits });
        return;
      }

      // CPF novo: autorização na credencial e avança para e-mail
      cpfWrapper?.classList.add('valid');
      if (data?.name && credentialStudentName) {
        credentialStudentName.textContent = data.name.toUpperCase();
      }
      if (credentialDoc) credentialDoc.textContent = `CPF: ${formatCPF(digits)}`;
      credentialStatusBadge?.classList.add('authorized');
      if (credentialStatusText) credentialStatusText.textContent = 'PRÉ-MATRÍCULA AUTORIZADA';

      advanceToEmailStep();
    }

    function showExistingCard(data: any, cpfDigits: string, phoneDigits: string) {
      clearTimers();
      stepPhone?.classList.add('hidden');
      stepCpf?.classList.add('hidden');
      stepEmail?.classList.add('hidden');
      stepExisting?.classList.remove('hidden');

      const existingPhoneMasked = modal?.querySelector<HTMLElement>('#existing-phone-masked');
      if (existingPhoneMasked && data.masked_phone) {
        existingPhoneMasked.textContent = data.masked_phone;
      }
      if (speech) {
        speech.textContent = 'Identificamos que seu CPF já possui matrícula vinculada.';
      }

      const attr = initAttribution();
      const targetUrl = new URL(`${appUrl}/autenticacao/otp`);
      if (data.external_id) targetUrl.searchParams.set('id', data.external_id);
      targetUrl.searchParams.set('tel', phoneDigits);
      targetUrl.searchParams.set('cpf', cpfDigits);
      if (attr?.ref) targetUrl.searchParams.set('ref', attr.ref);

      const existingLink = modal?.querySelector<HTMLAnchorElement>('#btn-existing-redirect');
      if (existingLink) {
        existingLink.href = targetUrl.toString();
      }

      const progressBar = modal?.querySelector<HTMLElement>('#existing-progress-bar');
      if (progressBar) {
        progressBar.style.transition = 'none';
        progressBar.style.transform = 'scaleX(1)';
        void progressBar.offsetWidth;
        progressBar.style.transition = 'transform 2.8s linear';
        progressBar.style.transform = 'scaleX(0)';
      }

      let seconds = 3;
      const countdownEl = modal?.querySelector<HTMLElement>('#existing-countdown');
      if (countdownEl) countdownEl.textContent = String(seconds);

      existingInterval = setInterval(() => {
        seconds -= 1;
        if (countdownEl && seconds >= 0) countdownEl.textContent = String(seconds);
      }, 1000);

      existingTimer = setTimeout(() => {
        window.location.href = targetUrl.toString();
      }, 2900);
    }

    function handleCpfInput() {
      if (!inputCpf) return;
      const digits = inputCpf.value.replace(/\D/g, '');
      inputCpf.value = formatCPF(digits);

      const isValid = validateCPF(digits);
      cpfWrapper?.classList.toggle('valid', isValid);

      if (isValid && digits.length === 11) {
        checkAndSubmitCpf(digits);
      } else {
        lastCheckedCpf = '';
        if (credentialDoc) credentialDoc.textContent = 'DOCUMENTAÇÃO PENDENTE';
        credentialStatusBadge?.classList.remove('authorized');
        if (credentialStatusText) credentialStatusText.textContent = 'AGUARDANDO VALIDAÇÃO';
      }
    }

    function advanceToEmailStep() {
      if (!inputCpf || !validateCPF(inputCpf.value)) return;

      stepPhone?.classList.add('hidden');
      stepCpf?.classList.add('hidden');
      stepEmail?.classList.remove('hidden');
      stepExisting?.classList.add('hidden');

      if (breadcrumbs && chipCpf && chipCpfText) {
        breadcrumbs.classList.remove('hidden');
        chipCpf.classList.remove('hidden');
        chipCpfText.textContent = inputCpf.value;
      }

      if (speech) {
        speech.textContent = 'E para qual e-mail enviamos a cópia do seu plano de estudos?';
      }

      setTimeout(() => { inputEmail?.focus(); }, 50);
    }

    inputCpf?.addEventListener('input', handleCpfInput);

    // ── ETAPA 3: E-MAIL ──────────────────────────────────────────────────────
    function handleEmailInput() {
      if (!inputEmail) return;
      const val = inputEmail.value.trim();
      const isValid = isEmailFormatValid(val);
      emailWrapper?.classList.toggle('valid', isValid);

      if (emailDebounceTimer) { clearTimeout(emailDebounceTimer); emailDebounceTimer = null; }

      if (isValid && !isSubmitting) {
        emailDebounceTimer = setTimeout(() => {
          if (isEmailFormatValid(inputEmail.value.trim())) submitLeadCapture();
        }, 350);
      }
    }

    inputEmail?.addEventListener('input', handleEmailInput);
    inputEmail?.addEventListener('blur', () => {
      if (inputEmail && isEmailFormatValid(inputEmail.value.trim()) && !isSubmitting) {
        submitLeadCapture();
      }
    });

    modal.querySelectorAll<HTMLButtonElement>('.domain-chip').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!inputEmail) return;
        const domain = btn.dataset.domain;
        if (domain) {
          inputEmail.value = completeEmailWithDomain(inputEmail.value, domain);
          handleEmailInput();
          if (isEmailFormatValid(inputEmail.value.trim())) submitLeadCapture();
        }
      });
    });

    modal.querySelector('#lead-capture-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!stepPhone?.classList.contains('hidden')) {
        const digits = inputPhone?.value.replace(/\D/g, '') ?? '';
        if (validatePhone(digits)) checkAndSubmitPhone(digits);
        return;
      }
      if (!stepCpf?.classList.contains('hidden')) {
        const digits = inputCpf?.value.replace(/\D/g, '') ?? '';
        if (validateCPF(digits)) checkAndSubmitCpf(digits);
        return;
      }
      if (!stepEmail?.classList.contains('hidden')) {
        if (inputEmail && isEmailFormatValid(inputEmail.value.trim())) submitLeadCapture();
      }
    });

    // ── SUBMISSÃO FINAL (AS 3 VALIDAÇÕES) ─────────────────────────────────────
    async function submitLeadCapture() {
      if (isSubmitting) return;

      const phoneDigits = inputPhone?.value.replace(/\D/g, '') ?? '';
      const cpfDigits = inputCpf?.value.replace(/\D/g, '') ?? '';
      const emailValue = inputEmail?.value.trim() ?? '';

      if (!validatePhone(phoneDigits)) { chipPhone?.click(); return; }
      if (!validateCPF(cpfDigits)) { chipCpf?.click(); return; }
      if (!isEmailFormatValid(emailValue)) { inputEmail?.focus(); return; }

      isSubmitting = true;
      emailWrapper?.classList.add('loading');
      emailWrapper?.classList.remove('valid');

      if (speech) {
        speech.textContent = 'Tudo pronto! Sua pré-matrícula foi autorizada. Redirecionando para seu ambiente de estudos...';
      }

      saveSession({ phone: phoneDigits, cpf: cpfDigits, email: emailValue });
      track('lead_capture_submitted', { has_cpf: true, has_email: true });

      const data = await checkAuth({
        contato: phoneDigits,
        phone: phoneDigits,
        cpf: cpfDigits,
        email: emailValue,
      });

      emailWrapper?.classList.remove('loading');
      emailWrapper?.classList.add('valid');

      redirectToOtp({
        id: data?.external_id,
        tel: phoneDigits,
        cpf: cpfDigits,
        email: emailValue,
      }, 300);
    }
  }
</script>
