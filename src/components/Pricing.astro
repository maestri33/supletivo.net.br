---
/**
 * Seção 5 — O preço. Ancoragem riscada + dígitos que rolam pra cima ao
 * entrar em cena + spotlight seguindo o mouse (desktop) + shine periódico.
 */
import CtaButton from './CtaButton.astro';
import { PRICE, perMonthBRL, pixBRL, fullBRL, savingsBRL, underPerMonthBRL } from '../data/price';

// dígitos animados a partir da parcela vinda do backend ("R$ 99")
const priceChars = perMonthBRL.split('');
---

<section id="preco" class="pricing section on-dark grain" aria-labelledby="pricing-title" data-section="preco">
  <span class="sec-num" aria-hidden="true" data-n="04"></span>
  <div class="container pricing-inner spatial-stage">
    <p class="kicker pricing-kicker" data-reveal>O investimento</p>
    <h2 id="pricing-title" data-reveal>Menos de {underPerMonthBRL} por mês.</h2>

    <div
      class="price-card spatial-card-3d"
      data-tilt-3d
      data-tilt-max="8"
      data-reveal
      data-price
      style="--d: 1"
    >
      <!-- Aleta de Destaque com Cores Fortes -->
      <div class="card-aleta hidden" data-card-aleta data-tilt-sublayer="40">
        <div class="aleta-flag">
          <span class="aleta-dot" aria-hidden="true"></span>
          <span class="aleta-text">CONDIÇÃO PROMOCIONAL ATIVA · LINK VERIFICADO <span data-aleta-promoter></span></span>
        </div>
      </div>

      <!-- Carimbo Grande Físico com Cores Fortes -->
      <div class="card-stamp hidden" data-card-stamp data-tilt-sublayer="55" aria-hidden="true">
        <div class="stamp-seal">
          <div class="stamp-seal-inner">
            <span class="stamp-seal-tag">★ SUPLETIVO BRASIL · MEC ★</span>
            <strong class="stamp-seal-title">DESCONTO APLICADO</strong>
            <span class="stamp-seal-sub">CONSULTOR AUTORIZADO · LOTE 01</span>
          </div>
        </div>
      </div>

      <p class="price-old hidden" data-price-old data-tilt-sublayer="20">
        de <s><span data-price-old-val>{fullBRL}</span></s>
      </p>

      <p class="price-main" data-tilt-sublayer="50">
        <span class="price-x">por</span>
        <strong class="price-value">
          <span class="sr-only" data-price-sr>{perMonthBRL} por mês</span>
          <span class="digits" data-price-digits aria-hidden="true">
            {priceChars.map((ch, i) => (
              <span class="digit" style={`--g: ${i}`}>{ch}</span>
            ))}
          </span>
        </strong>
        <span class="price-per" aria-hidden="true">/mês</span>
      </p>

      <p class="price-mode-line" data-price-mode-line data-tilt-sublayer="25">em {PRICE.installments}x no cartão de crédito</p>

      <p class="price-alt" data-tilt-sublayer="30">
        ou <strong data-price-pix-val>{pixBRL}</strong> à vista no Pix
        <span class="price-save hidden" data-price-save-line>— você economiza <span data-price-savings>{savingsBRL}</span></span>
      </p>

      <!-- Tríade de Confiança Decisória -->
      <ul class="trust-triad" data-tilt-sublayer="35">
        <li>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12.5l4.5 4.5L19 7.5" stroke="var(--green)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span><strong>Certificado Oficial</strong> credenciado ao MEC com publicação no Diário Oficial</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12.5l4.5 4.5L19 7.5" stroke="var(--green)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span><strong>Validade Nacional</strong> aceita em faculdades, concursos públicos e CNH</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12.5l4.5 4.5L19 7.5" stroke="var(--green)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span><strong>Garantia de 7 Dias:</strong> cancelou, devolvemos 100% do valor (Art. 49 CDC)</span>
        </li>
      </ul>

      <div data-tilt-sublayer="45" class="w-full">
        <CtaButton position="preco" class="btn-xl" />
      </div>
      <p class="microcopy">
        Material didático incluso · Sem mensalidades surpresa · Início imediato pelo celular
      </p>
    </div>
  </div>
</section>

<style>
  .pricing {
    background:
      radial-gradient(46rem 30rem at 50% 0%, rgb(255 196 0 / 0.1), transparent 65%),
      var(--ink);
    color: var(--paper);
    text-align: center;
    overflow: clip;
  }

  .pricing .sec-num {
    color: var(--paper);
  }

  .pricing-kicker {
    color: var(--yellow);
  }

  .pricing-inner {
    max-width: 44rem;
  }

  .price-card {
    position: relative;
    margin-top: 2.6rem;
    background:
      radial-gradient(
        26rem circle at var(--mx, 50%) var(--my, 20%),
        rgb(255 196 0 / 0.09),
        transparent 65%
      ),
      linear-gradient(180deg, var(--ink-soft), var(--ink));
    border: 1px solid rgb(255 196 0 / 0.35);
    border-radius: var(--radius-lg);
    padding: clamp(2rem, 5vw, 3.2rem) clamp(1.4rem, 5vw, 3rem);
    overflow: clip;
  }

  .price-card.has-consultant-discount {
    border-color: var(--yellow);
    box-shadow: 0 0 35px color-mix(in srgb, var(--yellow) 25%, transparent), 0 0 60px color-mix(in srgb, var(--danger) 15%, transparent);
  }

  /* Aleta de Alerta no Card de Preço — Conforme Design System */
  .card-aleta {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 1.25rem;
    position: relative;
    z-index: 10;
  }

  .aleta-flag {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 1.4rem;
    background: linear-gradient(90deg, #7f1d1d 0%, var(--danger) 50%, #7f1d1d 100%);
    border: 1.8px solid var(--yellow);
    border-radius: 9999px;
    box-shadow:
      0 4px 24px color-mix(in srgb, var(--danger) 55%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.4);
    color: #ffffff;
    font-size: clamp(0.75rem, 2.3vw, 0.86rem);
    font-weight: 900;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    animation: aletaPulse 2.5s infinite ease-in-out;
  }

  .aleta-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--yellow);
    box-shadow: 0 0 12px var(--yellow), 0 0 20px var(--yellow);
    flex-shrink: 0;
    animation: aletaBlink 1.2s infinite ease-in-out;
  }

  .aleta-text {
    line-height: 1.2;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8);
  }

  @keyframes aletaPulse {
    0%, 100% {
      transform: scale(1);
      box-shadow: 0 4px 24px color-mix(in srgb, var(--danger) 55%, transparent);
    }
    50% {
      transform: scale(1.025);
      box-shadow: 0 6px 30px color-mix(in srgb, var(--danger) 80%, transparent);
    }
  }

  @keyframes aletaBlink {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.35;
      transform: scale(0.85);
    }
  }

  /* Carimbo de Selo Oficial */
  .card-stamp {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0.5rem auto 1.5rem auto;
    position: relative;
    z-index: 12;
    pointer-events: none;
    user-select: none;
  }

  .card-stamp.is-stamped {
    animation: stampSlam 0.55s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  }

  .stamp-seal {
    display: inline-block;
    padding: 0.5rem 0.7rem;
    border: 3.5px double var(--danger);
    border-radius: 12px;
    background: color-mix(in srgb, var(--danger) 18%, transparent);
    box-shadow:
      0 0 35px color-mix(in srgb, var(--danger) 45%, transparent),
      inset 0 0 22px color-mix(in srgb, var(--danger) 25%, transparent);
    transform: rotate(-8deg);
    color: var(--danger);
    text-align: center;
    backdrop-filter: blur(6px);
  }

  .stamp-seal-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    border: 1.8px dashed color-mix(in srgb, var(--danger) 85%, transparent);
    padding: 0.6rem 1.6rem;
    border-radius: 8px;
  }

  .stamp-seal-tag {
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    color: var(--yellow-soft);
    text-shadow: 0 0 10px color-mix(in srgb, var(--yellow) 80%, transparent);
  }

  .stamp-seal-title {
    font-family: var(--font-display, 'Archivo Black', Impact, sans-serif);
    font-size: clamp(1.45rem, 5vw, 2.1rem);
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1;
    color: #ffffff;
    text-shadow:
      0 0 14px var(--danger),
      0 0 28px color-mix(in srgb, var(--danger) 80%, transparent),
      0 2px 4px rgba(0, 0, 0, 0.9);
    text-transform: uppercase;
  }

  .stamp-seal-sub {
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--yellow-soft);
    text-shadow: 0 0 8px color-mix(in srgb, var(--yellow-soft) 60%, transparent);
    text-transform: uppercase;
  }

  .trust-triad {
    list-style: none;
    padding: 0;
    margin: 1.5rem auto 1.8rem;
    max-width: 32rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    text-align: left;
  }

  .trust-triad li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.88rem;
    line-height: 1.4;
    color: var(--muted-on-dark);
  }

  .trust-triad li svg {
    width: 1.15rem;
    height: 1.15rem;
    flex: none;
    margin-top: 0.15rem;
  }

  .trust-triad li strong {
    color: #ffffff;
  }

  @keyframes stampSlam {
    0% {
      opacity: 0;
      transform: scale(1.65);
    }
    70% {
      opacity: 1;
      transform: scale(0.95);
    }
    85% {
      transform: scale(1.03);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-stamp.is-stamped,
    .aleta-flag,
    .aleta-dot {
      animation: none !important;
    }
  }

  .promo-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(90deg, #f59e0b, #eab308);
    color: #1e1b4b;
    font-weight: 800;
    font-size: 0.8rem;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 1.2rem;
    letter-spacing: 0.02em;
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
    animation: promoBadgePulse 2s infinite ease-in-out;
  }

  .promo-badge.hidden,
  .price-old.hidden,
  .price-save.hidden,
  .card-aleta.hidden,
  .card-stamp.hidden,
  .hidden {
    display: none !important;
  }

  @keyframes promoBadgePulse {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.03);
    }
  }

  /* brilho varrendo o card periodicamente */
  @media (prefers-reduced-motion: no-preference) {
    .price-card::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        115deg,
        transparent 42%,
        rgb(255 255 255 / 0.05) 50%,
        transparent 58%
      );
      transform: translateX(-130%);
      animation: card-shine 7s var(--ease-out) 3s infinite;
      pointer-events: none;
    }
  }

  @keyframes card-shine {
    0% {
      transform: translateX(-130%);
    }
    22%,
    100% {
      transform: translateX(130%);
    }
  }

  .price-old {
    font-size: var(--text-lg);
    color: var(--muted-on-dark);
  }

  .price-old s {
    position: relative;
    text-decoration: none;
    font-weight: 700;
    color: var(--paper);
    padding-inline: 0.1em;
  }

  .price-old s::after {
    content: '';
    position: absolute;
    left: -3%;
    right: -3%;
    top: 52%;
    height: 3px;
    border-radius: 2px;
    background: var(--yellow);
    transform: scaleX(0) rotate(-2deg);
    transform-origin: left center;
  }

  :global(html:not(.js)) .price-old s::after {
    transform: scaleX(1) rotate(-2deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .price-old s::after {
      transform: scaleX(1) rotate(-2deg);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) [data-price].in-view .price-old s::after {
      transition: transform 0.55s var(--ease-out) 0.5s;
      transform: scaleX(1) rotate(-2deg);
    }
  }

  /* tesoura "iniciando" o corte do preço antigo: aparece na ponta esquerda,
     dá três tesouradas enquanto o risco cresce, e some */
  .scissors {
    position: absolute;
    left: -1.6em;
    top: 50%;
    width: 1.25em;
    height: 1.25em;
    translate: 0 -50%;
    rotate: -2deg;
    opacity: 0;
    pointer-events: none;
  }

  /* sem JS ou com reduced-motion o risco já nasce pronto — tesoura não conta história nenhuma */
  :global(html:not(.js)) .scissors {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .scissors {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) [data-price].in-view .scissors {
      animation: scissors-cut 1.35s var(--ease-out) 0.35s forwards;
    }

    :global(html.js) [data-price].in-view .scissors .sc-a {
      transform-box: view-box;
      transform-origin: 12px 12px;
      animation: snip-a 1.35s ease-in-out 0.35s;
    }

    :global(html.js) [data-price].in-view .scissors .sc-b {
      transform-box: view-box;
      transform-origin: 12px 12px;
      animation: snip-b 1.35s ease-in-out 0.35s;
    }
  }

  @keyframes scissors-cut {
    0% {
      opacity: 0;
    }
    8%,
    74% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes snip-a {
    0%,
    100% {
      transform: rotate(0deg);
    }
    16%,
    48%,
    78% {
      transform: rotate(8deg);
    }
    32%,
    64% {
      transform: rotate(0deg);
    }
  }

  @keyframes snip-b {
    0%,
    100% {
      transform: rotate(0deg);
    }
    16%,
    48%,
    78% {
      transform: rotate(-8deg);
    }
    32%,
    64% {
      transform: rotate(0deg);
    }
  }

  .price-main {
    margin-top: 0.8rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.4rem 0.9rem;
  }

  .price-x {
    font-weight: 700;
    font-size: var(--text-lg);
  }

  .price-value {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-price);
    line-height: 1.05;
    color: var(--yellow);
    letter-spacing: -0.02em;
  }

  /* dígitos rolam de baixo pra cima, escalonados */
  .digits {
    display: inline-flex;
    overflow: clip;
  }

  .digit {
    display: inline-block;
  }

  /* o valor sobe como bloco único atrás do clip (odômetro). Antes cada
     dígito entrava em tempo diferente (--g) e, na seção mais decisiva, o
     primeiro frame parecia layout quebrado. Agora rola inteiro, de uma vez. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) [data-price] .digit {
      transform: translateY(110%);
    }

    :global(html.js) [data-price].in-view .digit {
      transition: transform 0.55s var(--ease-out) 0.3s;
      transform: none;
    }
  }

  .price-per {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1rem + 1vw, 1.7rem);
    color: var(--muted-on-dark);
    align-self: flex-end;
    padding-bottom: 0.35em;
  }

  .price-mode-line {
    margin-top: 0.5rem;
    font-weight: 700;
    font-size: var(--text-lg);
  }

  .price-save {
    display: inline-block;
    font-size: 0.85em;
    font-weight: 700;
    color: var(--yellow-soft);
  }

  .price-alt {
    margin-top: 0.9rem;
    font-size: var(--text-lg);
  }

  .price-alt strong {
    color: var(--yellow);
  }

  .price-warn {
    margin-top: 1.6rem;
    margin-bottom: 1.8rem;
    display: inline-block;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--ink);
    background: var(--yellow);
    border-radius: 999px;
    padding: 0.45em 1.1em;
    rotate: -1deg;
  }

  .price-guarantee {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1.6rem;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--paper);
  }

  .price-guarantee svg {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
    color: var(--yellow);
  }

  .pricing .microcopy {
    color: var(--muted-on-dark);
    max-width: 38ch;
    margin-inline: auto;
  }
</style>
