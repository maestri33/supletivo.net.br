{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "landing-supletivo-net-br",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "supletivo.net.br",
      "custom_domain": true
    },
    {
      "pattern": "www.supletivo.net.br",
      "custom_domain": true
    }
  ]
}
