{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "landing-supletivo-net-br",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "83b65dcc27344c23bdb2a917d597a785"
    }
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "supletivo.net.br/*",
      "zone_name": "supletivo.net.br"
    },
    {
      "pattern": "www.supletivo.net.br/*",
      "zone_name": "supletivo.net.br"
    }
  ]
}
