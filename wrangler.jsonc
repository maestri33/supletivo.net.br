{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "landing-supletivo-net-br",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "supletivo.net.br/*",
      "zone_name": "supletivo.net.br"
    },
    {
      "pattern": "www.supletivo.net.br/*",
      "zone_name": "supletivo.net.br"
    }
  ]
}
